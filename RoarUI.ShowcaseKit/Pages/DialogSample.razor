@page "/dialog-sample"

<h3>Dialog without Header</h3>
<RoarDialog Label="Dialog" WithoutHeader @bind-Open="DialogWithoutHeaderOpen">
    Look ma, no header! Sometimes you just need a clean, simple dialog.
    <RoarButton slot="@DialogSlot.Footer" Variant="ButtonVariant.Brand" data-dialog="close">Close</RoarButton>
</RoarDialog>
<RoarButton Appearance="ButtonAppearance.Filled" @onclick="() => DialogWithoutHeaderOpen = !DialogWithoutHeaderOpen">Open Dialog</RoarButton>

<h3>Dialog with Footer</h3>
<RoarDialog Label="Dialog" @bind-Open="DialogWithFooterOpen">
    Check out the footer below — it's a great place for actions and buttons.
    <RoarButton slot="@DialogSlot.Footer" Variant="ButtonVariant.Brand" data-dialog="close">Close</RoarButton>
</RoarDialog>
<RoarButton Appearance="ButtonAppearance.Filled" @onclick="() => DialogWithFooterOpen = !DialogWithFooterOpen">Open Dialog</RoarButton>

<h3>Opening and Closing Dialogs Declaratively</h3>
<RoarDialog Label="Dialog" id="dialog-opening">
    This dialog was opened declaratively — no JavaScript required!
    <RoarButton slot="@DialogSlot.Footer" Variant="ButtonVariant.Brand" data-dialog="close">Close</RoarButton>
</RoarDialog>
<RoarButton Appearance="ButtonAppearance.Filled" data-dialog="open dialog-opening">Open Dialog</RoarButton>

<h3>Custom Width</h3>
<RoarDialog Label="Dialog" id="dialog-custom-width" style="--width: 50vw;">
    This dialog is wider than the default — handy when you need more room for content.
    <RoarButton slot="@DialogSlot.Footer" Variant="ButtonVariant.Brand" data-dialog="close">Close</RoarButton>
</RoarDialog>
<RoarButton Appearance="ButtonAppearance.Filled" data-dialog="open dialog-custom-width">Open Dialog</RoarButton>

<h3>Scrolling</h3>
<RoarDialog Label="Dialog" id="dialog-scrolling">
    <div style="height: 150vh; border: dashed 2px var(--wa-color-surface-border); padding: 0 1rem;">
        <p>Scroll down and give it a try! 👇</p>
    </div>
    <RoarButton slot="@DialogSlot.Footer" Variant="ButtonVariant.Brand" data-dialog="close">Close</RoarButton>
</RoarDialog>
<RoarButton Appearance="ButtonAppearance.Filled" data-dialog="open dialog-scrolling">Open Dialog</RoarButton>

<h3>Header Actions</h3>
<RoarDialog Label="Dialog" id="dialog-header-actions">
    <RoarLinkButton slot="@DialogSlot.HeaderActions" Appearance="ButtonAppearance.Plain" Href="dialog-sample" Target="LinkTarget.Blank">
        <RoarIcon Name="arrow-up-right-from-square" Variant="FontAwesomeVariant.Solid" Label="Open in new window" />
    </RoarLinkButton>
    You can add custom actions to the header, like the icon button up there!
    <RoarButton slot="@DialogSlot.Footer" Variant="ButtonVariant.Brand" data-dialog="close">Close</RoarButton>
</RoarDialog>
<RoarButton Appearance="ButtonAppearance.Filled" data-dialog="open dialog-header-actions">Open Dialog</RoarButton>

<h3>Light Dismissal</h3>
<RoarDialog Label="Dialog" id="dialog-light-dismissal" LightDismiss>
    This dialog will close when you click on the overlay.
    <RoarButton slot="@DialogSlot.Footer" Variant="ButtonVariant.Brand" data-dialog="close">Close</RoarButton>
</RoarDialog>
<RoarButton Appearance="ButtonAppearance.Filled" data-dialog="open dialog-light-dismissal">Open Dialog</RoarButton>

<h3>Preventing the Dialog from Closing</h3>
<RoarDialog Label="Dialog" id="dialog-prevent-dismissal" OnHidePreventDefault="DialogPreventDismiss" OnShow="OnDialogPreventDismissShow" @ref="PreventDismissDialog">
    This dialog will only close when you click the button below.
    <RoarButton slot="@DialogSlot.Footer" Variant="ButtonVariant.Brand" @onclick="ClosePreventDismissDialog">Only this button will close it</RoarButton>
</RoarDialog>
<RoarButton Appearance="ButtonAppearance.Filled" data-dialog="open dialog-prevent-dismissal">Open Dialog</RoarButton>

@code {
    public bool DialogWithoutHeaderOpen { get; set; } = false;
    public bool DialogWithFooterOpen { get; set; } = false;
    public bool DialogPreventDismiss { get; set; } = true;
    public RoarDialog PreventDismissDialog { get; set; }

    public async Task OnDialogPreventDismissShow()
    {
        DialogPreventDismiss = true;
    }

    public async Task ClosePreventDismissDialog()
    {
        DialogPreventDismiss = false;
        await Task.Delay(1); // Render UI before calling close
        await PreventDismissDialog.HideAsync();
    }
}
