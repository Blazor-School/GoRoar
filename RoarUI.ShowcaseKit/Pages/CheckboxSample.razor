@page "/checkbox-sample"
@using System.Linq.Expressions

<h3>Checked</h3>
<RoarCheckbox @bind-Checked="Check1">Checked</RoarCheckbox>

<h3>Indeterminate</h3>
<RoarIndeterminateCheckbox @bind-Checked="IndeterminateCheck">Indeterminate</RoarIndeterminateCheckbox>
<RoarButton @onclick="() => IndeterminateCheck = null">Indeterminate state: @(IndeterminateCheck is not null ? IndeterminateCheck.ToString() : "NULL"). Click to set interdeterminate</RoarButton>

<h3>Disabled</h3>
<RoarCheckbox @bind-Checked="Check2" Disabled>Disabled</RoarCheckbox>

<h3>Sizes</h3>
<RoarCheckbox @bind-Checked="Check3" Size="CheckboxSize.Xs">Extra Small</RoarCheckbox>
<RoarCheckbox @bind-Checked="Check3" Size="CheckboxSize.S">Small</RoarCheckbox>
<RoarCheckbox @bind-Checked="Check3" Size="CheckboxSize.M">Medium</RoarCheckbox>
<RoarCheckbox @bind-Checked="Check3" Size="CheckboxSize.L">Large</RoarCheckbox>
<RoarCheckbox @bind-Checked="Check3" Size="CheckboxSize.Xl">Extra Large</RoarCheckbox>

<h3>Hint</h3>
<RoarCheckbox @bind-Checked="Check4" Hint="What should the user know about the checkbox?">Label</RoarCheckbox>

<h3>Custom Validity</h3>
<EditForm Model="Form">
    <DataAnnotationsValidator />
    <RoarCheckbox @bind-Checked="@Form.CheckMe">Check me</RoarCheckbox>
    <ValidationMessage For="@(() => Form.CheckMe)" />
    <RoarButton Appearance="ButtonAppearance.Filled" Variant="ButtonVariant.Neutral" Type="ButtonType.Submit">Submit</RoarButton>
</EditForm>

@code {
    public CheckboxCustomValidityForm Form { get; set; } = new();
    public Expression<Func<bool>> CheckMeExpression => () => Form.CheckMe;
    public bool Check1 { get; set; }
    public bool Check2 { get; set; }
    public bool Check3 { get; set; }
    public bool Check4 { get; set; }
    public bool? IndeterminateCheck { get; set; }
}
