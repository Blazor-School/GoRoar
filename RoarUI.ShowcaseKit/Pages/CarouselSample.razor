    </RoarCarouselItem>
</RoarCarousel>
<div class="thumbnails">
    <div class="scroller">
        <img alt="Thumbnail by 1" class="image @(ActiveThumbnailIndex == 0 ? "active" : "")" src="https://images.unsplash.com/photo-1426604966848-d7adac402bff?q=10" @onclick="async () => await ThumbnailCarousel.GoToSlideAsync(0)" @ref="ThumbnailElements[0]" />
        <img alt="Thumbnail by 2" class="image @(ActiveThumbnailIndex == 1 ? "active" : "")" src="https://images.unsplash.com/photo-1473448912268-2022ce9509d8?q=10" @onclick="async () => await ThumbnailCarousel.GoToSlideAsync(1)" @ref="ThumbnailElements[1]" />
        <img alt="Thumbnail by 3" class="image @(ActiveThumbnailIndex == 2 ? "active" : "")" src="https://images.unsplash.com/photo-1499002238440-d264edd596ec?q=10" @onclick="async () => await ThumbnailCarousel.GoToSlideAsync(2)" @ref="ThumbnailElements[2]" />
        <img alt="Thumbnail by 4" class="image @(ActiveThumbnailIndex == 3 ? "active" : "")" src="https://images.unsplash.com/photo-1475113548554-5a36f1f523d6?q=10" @onclick="async () => await ThumbnailCarousel.GoToSlideAsync(3)" @ref="ThumbnailElements[3]" />
        <img alt="Thumbnail by 5" class="image @(ActiveThumbnailIndex == 4 ? "active" : "")" src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?q=10" @onclick="async () => await ThumbnailCarousel.GoToSlideAsync(4)" @ref="ThumbnailElements[4]" />
    </div>
</div>

<style>
    .dynamic-carousel {
        --aspect-ratio: 3 / 2;
    }

    .dynamic-carousel wa-carousel-item {
        flex: 0 0 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--wa-font-size-2xl);
    }

    .carousel-thumbnails {
        --slide-aspect-ratio: 3 / 2;
    }

    .thumbnails {
        display: flex;
        justify-content: center;
    }

    .scroller {
        display: flex;
        gap: var(--wa-space-s);
        overflow-x: auto;
        scrollbar-width: none;
        scroll-behavior: smooth;
        scroll-padding: var(--wa-space-s);
    }

    .scroller::-webkit-scrollbar {
        display: none;
    }

    .image {
        width: 64px;
        height: 64px;
        object-fit: cover;
        opacity: 0.3;
        will-change: opacity;
        transition: 250ms opacity;
        cursor: pointer;
    }

    .image.active {
        opacity: 1;
    }
</style>

@code {
    [Inject]
    public IJSRuntime JSRuntime { get; set; } = default!;

    public string AspectRatio { get; set; } = "3/2";
    public bool MouseDraggingEnabled { get; set; } = false;
    public ElementReference MouseDraggingToggle { get; set; }
    public int DynamicSlideCount { get; set; } = 3;
    public string[] SlideColors { get; set; } = ["red", "orange", "yellow", "green", "blue", "purple"];
    public RoarCarousel ThumbnailCarousel { get; set; } = default!;
    public int ActiveThumbnailIndex { get; set; } = 0;
    public ElementReference[] ThumbnailElements { get; set; } = new ElementReference[5];

    public void ChangeAspectRatio(ChangeEventArgs args) => AspectRatio = args.Value?.ToString() ?? "3/2";

    public async Task ToggleMouseDraggingAsync()
    {
        MouseDraggingEnabled = await JSRuntime.InvokeAsync<bool>("getObjectProperty", MouseDraggingToggle, "checked");
    }

    public void RemoveSlide()
    {
        if (DynamicSlideCount > 1)
        {
            DynamicSlideCount--;
        }
    }

    public async Task HandleThumbnailSlideChangeAsync(CarouselSlideChangeEventArgs args)
    {
        ActiveThumbnailIndex = args.Index;
        await JSRuntime.InvokeVoidAsync("executeJsFunctionFromJsObject", ThumbnailElements[ActiveThumbnailIndex], "scrollIntoView", new { block = "nearest" });
    }
}
