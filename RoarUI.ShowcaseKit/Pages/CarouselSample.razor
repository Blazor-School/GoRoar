        </RoarCarouselItem>
    </RoarCarousel>
    <RoarDivider />
    <RoarDependency ComponentName="switch" />
    <wa-switch @onchange="ToggleMouseDraggingAsync" @ref="MouseDraggingToggle">Enable mouse dragging</wa-switch>
</div>

<h3>Adding &amp; Removing Slides</h3>
<RoarCarousel class="dynamic-carousel" Pagination Navigation Loop>
    @foreach (int number in Enumerable.Range(1, DynamicSlideCount))
    {
        <RoarCarouselItem @key="number" style="@($"background: {SlideColors[(number - 1) % SlideColors.Length]};")">Slide @number</RoarCarouselItem>
    }
</RoarCarousel>
<RoarDivider />
<div class="wa-cluster">
    <RoarButton Appearance="ButtonAppearance.Filled" id="dynamic-add" @onclick="() => DynamicSlideCount++">Add slide</RoarButton>
    <RoarButton Appearance="ButtonAppearance.Filled" id="dynamic-remove" Disabled="@(DynamicSlideCount <= 1)" @onclick="RemoveSlide">Remove slide</RoarButton>
</div>

<h3>Thumbnail Gallery</h3>
<RoarCarousel class="carousel-thumbnails" Navigation Loop OnSlideChange="HandleThumbnailSlideChangeAsync" @ref="ThumbnailCarousel">
    <RoarCarouselItem>
        <img alt="The sun shines on the mountains and trees (by Adam Kool on Unsplash)" src="https://images.unsplash.com/photo-1426604966848-d7adac402bff?q=10" />
