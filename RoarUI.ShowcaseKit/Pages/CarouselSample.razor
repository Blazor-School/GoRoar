</RoarCarousel>
<RoarDivider />
<div class="wa-cluster">
    <RoarDependency ComponentName="select" />
    <RoarDependency ComponentName="option" />
    <wa-select label="Aspect ratio" name="aspect" value="@AspectRatio" @onchange="ChangeAspectRatio">
        <wa-option value="1/1">1/1</wa-option>
        <wa-option value="3/2">3/2</wa-option>
        <wa-option value="16/9">16/9</wa-option>
    </wa-select>
</div>

