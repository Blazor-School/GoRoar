<style>
    .vertical {
        max-height: 400px;
    }

        .vertical::part(carousel) {
            grid-template-areas: 'slides slides pagination';
        }

        .vertical::part(pagination) {
            flex-direction: column;
        }

        .vertical::part(navigation) {
            transform: rotate(90deg);
            display: flex;
        }
</style>

<h3>Aspect Ratio</h3>
