@page "/input-date-sample"

<h3>Label</h3>
<RoarInputDate Value="new DateOnly(2026, 9, 17)" Label="What is your birthday?" />

<h3>Hint</h3>
<RoarInputDate Value="new DateOnly(2026, 9, 17)" Label="Birthday" Hint="What is your birthday?" />

<h3>Clearable</h3>
<RoarInputDate Value="new DateOnly(2026, 9, 17)" WithClear />

<h3>Appearance</h3>
<RoarInputDate Value="new DateOnly(2026, 9, 17)" Appearance="InputAppearance.Outlined" />
<RoarInputDate Value="new DateOnly(2026, 9, 17)" Appearance="InputAppearance.Filled" />
<RoarInputDate Value="new DateOnly(2026, 9, 17)" Appearance="InputAppearance.FilledOutlined" />

<h3>Disabled</h3>
<RoarInputDate Value="new DateOnly(2026, 9, 17)" Disabled />

<h3>Readonly</h3>
<RoarInputDate Value="new DateOnly(2026, 9, 17)" Label="Anniversary" ReadOnly />

<h3>Size</h3>
<div class="wa-stack">
    <RoarInputDate Value="new DateOnly(2026, 9, 17)" Size="InputSize.Xs" />
    <RoarInputDate Value="new DateOnly(2026, 9, 17)" Size="InputSize.S" />
    <RoarInputDate Value="new DateOnly(2026, 9, 17)" Size="InputSize.M" />
    <RoarInputDate Value="new DateOnly(2026, 9, 17)" Size="InputSize.L" />
    <RoarInputDate Value="new DateOnly(2026, 9, 17)" Size="InputSize.Xl" />
</div>

<h3>Pill</h3>
<RoarInputDate Value="new DateOnly(2026, 9, 17)" Pill />

<h3>Start & End Decorations</h3>
<div class="wa-stack">
    <RoarInputDate Value="new DateOnly(2026, 9, 17)"  Label="Start">
        <RoarIcon Name="magnifying-glass" slot="@InputSlot.Start" />
    </RoarInputDate>
    <RoarInputDate Value="new DateOnly(2026, 9, 17)"  Label="End">
        <RoarIcon Name="globe" slot="@InputSlot.Start" />
        <RoarIcon Name="circle-info" slot="@InputSlot.End" />
    </RoarInputDate>
</div>

<h3>Binding</h3>
<RoarInputDate @bind-Value="DateSample" />
@DateSample

@code {
    public DateOnly DateSample { get; set; } = new(2028,9,17);
}