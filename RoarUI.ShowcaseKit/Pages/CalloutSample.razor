@page "/callout-sample"

<h3>Variants</h3>
<div class="d-flex flex-column gap-3">
    <RoarCallout Variant="CalloutVariant.Brand">
        <RoarIcon slot="@CalloutSlot.Icon" Name="circle-info" />
        <strong>This is super informative</strong><br />
        You can tell by how pretty the callout is.
    </RoarCallout>
    <RoarCallout Variant="CalloutVariant.Success">
        <RoarIcon slot="@CalloutSlot.Icon" Name="circle-check" />
        <strong>Your changes have been saved</strong><br />
        You can safely exit the app now.
    </RoarCallout>
    <RoarCallout Variant="CalloutVariant.Neutral">
        <RoarIcon slot="@CalloutSlot.Icon" Name="gear" />
        <strong>Your settings have been updated</strong><br />
        Settings will take effect on next login.
    </RoarCallout>
    <RoarCallout Variant="CalloutVariant.Warning">
        <RoarIcon slot="@CalloutSlot.Icon" Name="triangle-exclamation" />
        <strong>Your session has ended</strong><br />
        Please login again to continue.
    </RoarCallout>
    <RoarCallout Variant="CalloutVariant.Danger">
        <RoarIcon slot="@CalloutSlot.Icon" Name="circle-exclamation" />
        <strong>Your account has been deleted</strong><br />
        We're very sorry to see you go!
    </RoarCallout>
</div>

<h3>Appearance</h3>
<div class="d-flex flex-column gap-3">
    <RoarCallout Variant="CalloutVariant.Brand" Appearance="CalloutAppearance.Accent">
        <RoarIcon slot="@CalloutSlot.Icon" Name="square-check" />
        This <strong>accent</strong> callout draws attention
    </RoarCallout>
    <RoarCallout Variant="CalloutVariant.Brand" Appearance="CalloutAppearance.FilledOutlined">
        <RoarIcon slot="@CalloutSlot.Icon" Name="fill-drip" />
        This callout is both <strong>filled</strong> and <strong>outlined</strong>
    </RoarCallout>
    <RoarCallout Variant="CalloutVariant.Brand" Appearance="CalloutAppearance.Filled">
        <RoarIcon slot="@CalloutSlot.Icon" Name="fill" />
        This callout is only <strong>filled</strong>
    </RoarCallout>
    <RoarCallout Variant="CalloutVariant.Brand" Appearance="CalloutAppearance.Outlined">
        <RoarIcon slot="@CalloutSlot.Icon" Name="lines-leaning" />
        Here's an <strong>outlined</strong> callout
    </RoarCallout>
    <RoarCallout Variant="CalloutVariant.Brand" Appearance="CalloutAppearance.Plain">
        <RoarIcon slot="@CalloutSlot.Icon" Name="font" />
        No bells and whistles on this <strong>plain</strong> callout
    </RoarCallout>
</div>

<h3>Sizes</h3>
<div class="d-flex flex-column gap-3">
    <RoarCallout Size="CalloutSize.Xs">
        <RoarIcon slot="@CalloutSlot.Icon" Name="circle-info" />
        Extra-small callout for minimal emphasis.
    </RoarCallout>
    <RoarCallout Size="CalloutSize.S">
        <RoarIcon slot="@CalloutSlot.Icon" Name="circle-info" />
        Small callout for a bit of emphasis.
    </RoarCallout>
    <RoarCallout Size="CalloutSize.M">
        <RoarIcon slot="@CalloutSlot.Icon" Name="circle-info" />
        Medium callout, the default size.
    </RoarCallout>
    <RoarCallout Size="CalloutSize.L">
        <RoarIcon slot="@CalloutSlot.Icon" Name="circle-info" />
        Large callout for more emphasis.
    </RoarCallout>
    <RoarCallout Size="CalloutSize.Xl">
        <RoarIcon slot="@CalloutSlot.Icon" Name="circle-info" />
        Extra-large callout for maximum emphasis.
    </RoarCallout>
</div>

<h3>Wihout Icons</h3>
<RoarCallout Variant="CalloutVariant.Brand">Nothing fancy here, just a simple callout.</RoarCallout>