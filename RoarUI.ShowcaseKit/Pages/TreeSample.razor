        </RoarTreeItem>
    </RoarTreeItem>
</RoarTree>

@code {
    public string Value { get; set; } = "laptops";
    public string LeafValue { get; set; } = "laptops";
    public List<string> Values { get; set; } = ["phones", "smartphones", "accessories"];
    public List<string> Repositories { get; set; } = [];

    public async Task LoadItemAsync()
    {
        await Task.Delay(1000);
        Repositories = new() { "Repo 1", "Repo 2", "Repo 3" };
    }
}
