@page "/tree-sample"

<h3>Single Select</h3>
<RoarTree @bind-Value="Value">
    <RoarTreeItem Value="Electronics" Expanded>
        Electronics
        <RoarTreeItem Value="computers" Expanded>
            Computers
            <RoarTreeItem Value="laptops">Laptops</RoarTreeItem>
            <RoarTreeItem Value="desktops">Desktops</RoarTreeItem>
            <RoarTreeItem Value="tablets">Tablets</RoarTreeItem>
        </RoarTreeItem>
        <RoarTreeItem Value="phones">
            Phones
            <RoarTreeItem Value="smartphones">Smartphones</RoarTreeItem>
            <RoarTreeItem Value="accessories">Accessories</RoarTreeItem>
        </RoarTreeItem>
    </RoarTreeItem>
    <RoarTreeItem Value="clothing">
        Clothing
        <RoarTreeItem Value="shirts">Shirts</RoarTreeItem>
        <RoarTreeItem Value="pants">Pants</RoarTreeItem>
        <RoarTreeItem Value="shoes">Shoes</RoarTreeItem>
    </RoarTreeItem>
    <RoarTreeItem Value="books">Books</RoarTreeItem>
</RoarTree>
<div>Selected Value: @Value</div>

<h3>Single Select (Leaf Only)</h3>
<RoarTree @bind-Value="LeafValue" LeafOnly>
    <RoarTreeItem Value="Electronics" Expanded>
        Electronics
        <RoarTreeItem Value="computers" Expanded>
            Computers
            <RoarTreeItem Value="laptops">Laptops</RoarTreeItem>
            <RoarTreeItem Value="desktops">Desktops</RoarTreeItem>
            <RoarTreeItem Value="tablets">Tablets</RoarTreeItem>
        </RoarTreeItem>
        <RoarTreeItem Value="phones">
            Phones
            <RoarTreeItem Value="smartphones">Smartphones</RoarTreeItem>
            <RoarTreeItem Value="accessories">Accessories</RoarTreeItem>
        </RoarTreeItem>
    </RoarTreeItem>
    <RoarTreeItem Value="clothing">
        Clothing
        <RoarTreeItem Value="shirts">Shirts</RoarTreeItem>
        <RoarTreeItem Value="pants">Pants</RoarTreeItem>
        <RoarTreeItem Value="shoes">Shoes</RoarTreeItem>
    </RoarTreeItem>
    <RoarTreeItem Value="books">Books</RoarTreeItem>
</RoarTree>
<div>Selected Value: @LeafValue</div>

<h3>Multiple Select</h3>
<RoarTreeMultipleSelect @bind-Values="Values">
    <RoarTreeItem Value="Electronics" Expanded>
        Electronics
        <RoarTreeItem Value="computers">
            Computers
            <RoarTreeItem Value="laptops">Laptops</RoarTreeItem>
            <RoarTreeItem Value="desktops">Desktops</RoarTreeItem>
            <RoarTreeItem Value="tablets">Tablets</RoarTreeItem>
        </RoarTreeItem>
        <RoarTreeItem Value="phones" Expanded>
            Phones
            <RoarTreeItem Value="smartphones">Smartphones</RoarTreeItem>
            <RoarTreeItem Value="accessories">Accessories</RoarTreeItem>
        </RoarTreeItem>
    </RoarTreeItem>
    <RoarTreeItem Value="clothing">
        Clothing
        <RoarTreeItem Value="shirts">Shirts</RoarTreeItem>
        <RoarTreeItem Value="pants">Pants</RoarTreeItem>
        <RoarTreeItem Value="shoes">Shoes</RoarTreeItem>
    </RoarTreeItem>
    <RoarTreeItem Value="books">Books</RoarTreeItem>
</RoarTreeMultipleSelect>
<div>Selected Values: @string.Join(", ", Values)</div>

<h3>Sizes</h3>
<RoarTreeMultipleSelect style="font-size: 1.5rem;">
    <RoarTreeItem Expanded>
        Large
        <RoarTreeItem>Newsletters</RoarTreeItem>
        <RoarTreeItem>
            Promotions
            <RoarTreeItem>Weekly deals</RoarTreeItem>
            <RoarTreeItem>Seasonal sales</RoarTreeItem>
        </RoarTreeItem>
    </RoarTreeItem>
</RoarTreeMultipleSelect>

<h3>Showing Indent Guides</h3>
<RoarTree style="--indent-guide-width: 1px;">
    <RoarTreeItem Expanded>
        Design
        <RoarTreeItem Expanded>
            Brand
            <RoarTreeItem>Colors</RoarTreeItem>
            <RoarTreeItem>Typography</RoarTreeItem>
            <RoarTreeItem>Logo</RoarTreeItem>
        </RoarTreeItem>
        <RoarTreeItem>
            Components
            <RoarTreeItem>Buttons</RoarTreeItem>
            <RoarTreeItem>Forms</RoarTreeItem>
            <RoarTreeItem>Navigation</RoarTreeItem>
        </RoarTreeItem>
    </RoarTreeItem>

    <RoarTreeItem Expanded>
        Development
        <RoarTreeItem>Frontend</RoarTreeItem>
        <RoarTreeItem>Backend</RoarTreeItem>
        <RoarTreeItem>Infrastructure</RoarTreeItem>
    </RoarTreeItem>

    <RoarTreeItem>
        Marketing
        <RoarTreeItem>Social Media</RoarTreeItem>
        <RoarTreeItem>Email Campaigns</RoarTreeItem>
        <RoarTreeItem>Analytics</RoarTreeItem>
    </RoarTreeItem>
</RoarTree>

<h3>Lazy Loading</h3>
<RoarTree>
    <RoarTreeItem Lazy="true" OnLazyLoad="LoadItemAsync">
        Remote Repositories

        @foreach(string repository in Repositories)
        {
            <RoarTreeItem Value="@repository">
                @repository
            </RoarTreeItem>
        }
    </RoarTreeItem>
</RoarTree>

<h3>Customizing the Expand and Collapse Icons</h3>
<RoarTree class="custom-icons">
    <RoarIcon Name="square-plus" Variant="FontAwesomeVariant.Solid" slot="@TreeSlot.ExpandIcon" />
    <RoarIcon Name="square-minus" Variant="FontAwesomeVariant.Solid" slot="@TreeSlot.CollapseIcon" />
    <RoarTreeItem Expanded>
        Recipes
        <RoarTreeItem Expanded>
            Breakfast
            <RoarTreeItem>Pancakes</RoarTreeItem>
            <RoarTreeItem>Omelette</RoarTreeItem>
            <RoarTreeItem>Granola</RoarTreeItem>
        </RoarTreeItem>
        <RoarTreeItem>
            Lunch
            <RoarTreeItem>Caesar salad</RoarTreeItem>
            <RoarTreeItem>Grilled chicken wrap</RoarTreeItem>
        </RoarTreeItem>
        <RoarTreeItem>
            Dinner
            <RoarTreeItem>Pasta carbonara</RoarTreeItem>
            <RoarTreeItem>Stir fry</RoarTreeItem>
            <RoarTreeItem>Roasted salmon</RoarTreeItem>
        </RoarTreeItem>
    </RoarTreeItem>

    <RoarTreeItem>
        Desserts
        <RoarTreeItem>Chocolate cake</RoarTreeItem>
        <RoarTreeItem>Tiramisu</RoarTreeItem>
        <RoarTreeItem>Fruit tart</RoarTreeItem>
    </RoarTreeItem>
</RoarTree>

<style>
  .custom-icons wa-tree-item::part(expand-button) {
    /* Disable the expand/collapse animation */
    rotate: none;
  }
</style>

<h3>With Icons</h3>
<RoarTree>
    <RoarTreeItem Expanded>
        <RoarIcon Name="folder" Variant="FontAwesomeVariant.Regular"/>
