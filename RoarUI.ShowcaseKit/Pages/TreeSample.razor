        </RoarTreeItem>

        <RoarTreeItem Expanded>
            <RoarIcon Name="folder" Variant="FontAwesomeVariant.Regular"/>
            Work
            <RoarTreeItem>
                <RoarIcon Name="file-pdf" Variant="FontAwesomeVariant.Regular"/>
                quarterly-report.pdf
            </RoarTreeItem>
            <RoarTreeItem>
                <RoarIcon Name="file-lines" Variant="FontAwesomeVariant.Regular"/>
