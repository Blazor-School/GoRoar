@page "/input-datetime-sample"

<h3>Label</h3>
<RoarInputDateTime Value="new DateTime(2026, 9, 17)" Label="What is your birthday?" />

<h3>Hint</h3>
<RoarInputDateTime Value="new DateTime(2026, 9, 17)" Label="Birthday" Hint="What is your birthday?" />

<h3>Clearable</h3>
<RoarInputDateTime Value="new DateTime(2026, 9, 17)" WithClear />

<h3>Appearance</h3>
<RoarInputDateTime Value="new DateTime(2026, 9, 17)" Appearance="InputAppearance.Outlined" />
<RoarInputDateTime Value="new DateTime(2026, 9, 17)" Appearance="InputAppearance.Filled" />
<RoarInputDateTime Value="new DateTime(2026, 9, 17)" Appearance="InputAppearance.FilledOutlined" />

<h3>Disabled</h3>
<RoarInputDateTime Value="new DateTime(2026, 9, 17)" Disabled />

<h3>Readonly</h3>
<RoarInputDateTime Value="new DateTime(2026, 9, 17)" Label="Anniversary" ReadOnly />

<h3>Size</h3>
<div class="wa-stack">
    <RoarInputDateTime Value="new DateTime(2026, 9, 17)" Size="InputSize.Xs" />
    <RoarInputDateTime Value="new DateTime(2026, 9, 17)" Size="InputSize.S" />
    <RoarInputDateTime Value="new DateTime(2026, 9, 17)" Size="InputSize.M" />
    <RoarInputDateTime Value="new DateTime(2026, 9, 17)" Size="InputSize.L" />
    <RoarInputDateTime Value="new DateTime(2026, 9, 17)" Size="InputSize.Xl" />
</div>

<h3>Pill</h3>
<RoarInputDateTime Value="new DateTime(2026, 9, 17)" Pill />

<h3>Start & End Decorations</h3>
<div class="wa-stack">
    <RoarInputDateTime Value="new DateTime(2026, 9, 17)" Label="Start">
        <RoarIcon Name="magnifying-glass" slot="@InputSlot.Start" />
    </RoarInputDateTime>
    <RoarInputDateTime Value="new DateTime(2026, 9, 17)" Label="End">
        <RoarIcon Name="globe" slot="@InputSlot.Start" />
        <RoarIcon Name="circle-info" slot="@InputSlot.End" />
    </RoarInputDateTime>
</div>

<h3>Binding</h3>
<RoarInputDateTime @bind-Value="DateSample" />
@DateSample

@code {
    public DateTime? DateSample { get; set; } = new(2028, 9, 17);
}