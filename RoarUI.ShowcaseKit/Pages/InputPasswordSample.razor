@page "/input-password-sample"

<h3>Label</h3>
<RoarInputPassword Label="What is your password?" />

<h3>Hint</h3>
<RoarInputPassword Label="Repeat Password" Hint="Type your password again" />

<h3>Placeholder</h3>
<RoarInputPassword Placeholder="Type your new password" />

<h3>Clearable</h3>
<RoarInputPassword Placeholder="Clearable" WithClear />

<h3>Appearance</h3>
<RoarInputPassword Appearance="InputAppearance.Outlined" Placeholder="outlined" />
<RoarInputPassword Appearance="InputAppearance.Filled" Placeholder="filled" />
<RoarInputPassword Appearance="InputAppearance.FilledOutlined" Placeholder="filled-outlined" />

<h3>Disabled</h3>
<RoarInputPassword Placeholder="Disabled" Disabled />

<h3>Readonly</h3>
<RoarInputPassword Label="Old Password" Value="Old Password" ReadOnly />

<h3>Password Toggle</h3>
<RoarInputPassword Placeholder="Toggle" PasswordToggle="true" Value="Old Password" />

<h3>Password Visible</h3>
<RoarInputPassword Placeholder="Visible" PasswordVisible="true" Value="Old Password" />

<h3>Size</h3>
<div class="wa-stack">
    <RoarInputPassword Size="InputSize.Xs" Placeholder="Extra small" />
    <RoarInputPassword Size="InputSize.S" Placeholder="Small" />
    <RoarInputPassword Size="InputSize.M" Placeholder="Medium" />
    <RoarInputPassword Size="InputSize.L" Placeholder="Large" />
    <RoarInputPassword Size="InputSize.Xl" Placeholder="Extra large" />
</div>

<h3>Pill</h3>
<RoarInputPassword Placeholder="Search" Pill />

<h3>Start & End Decorations</h3>
<div class="wa-stack">
    <RoarInputPassword Label="Search" Placeholder="Search the docs">
        <RoarIcon Name="magnifying-glass" slot="@InputSlot.Start" />
    </RoarInputPassword>
    <RoarInputPassword Label="Website" Placeholder="example.com">
        <RoarIcon Name="globe" slot="@InputSlot.Start" />
        <RoarIcon Name="circle-info" slot="@InputSlot.End" />
    </RoarInputPassword>
</div>

<h3>Binding</h3>
<RoarInputPassword @bind-Value="UserInput" Placeholder="Type something" />
@UserInput

@code {
    public string UserInput { get; set; } = "ROAR!";
}