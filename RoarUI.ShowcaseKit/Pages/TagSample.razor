@page "/tag-sample"

<h3>Appearance and Variant</h3>
<div>
    <RoarTag Variant="TagVariant.Brand" Appearance="TagAppearance.Accent">Accent</RoarTag>
    <RoarTag Variant="TagVariant.Brand" Appearance="TagAppearance.FilledOutlined">Filled-Outlined</RoarTag>
    <RoarTag Variant="TagVariant.Brand" Appearance="TagAppearance.Filled">Filled</RoarTag>
    <RoarTag Variant="TagVariant.Brand" Appearance="TagAppearance.Outlined">Outlined</RoarTag>
</div>

<div>
    <RoarTag Variant="TagVariant.Success" Appearance="TagAppearance.Accent">Accent</RoarTag>
    <RoarTag Variant="TagVariant.Success" Appearance="TagAppearance.FilledOutlined">Filled-Outlined</RoarTag>
    <RoarTag Variant="TagVariant.Success" Appearance="TagAppearance.Filled">Filled</RoarTag>
    <RoarTag Variant="TagVariant.Success" Appearance="TagAppearance.Outlined">Outlined</RoarTag>
</div>

<div>
    <RoarTag Variant="TagVariant.Neutral" Appearance="TagAppearance.Accent">Accent</RoarTag>
    <RoarTag Variant="TagVariant.Neutral" Appearance="TagAppearance.FilledOutlined">Filled-Outlined</RoarTag>
    <RoarTag Variant="TagVariant.Neutral" Appearance="TagAppearance.Filled">Filled</RoarTag>
    <RoarTag Variant="TagVariant.Neutral" Appearance="TagAppearance.Outlined">Outlined</RoarTag>
</div>

<div>
    <RoarTag Variant="TagVariant.Warning" Appearance="TagAppearance.Accent">Accent</RoarTag>
    <RoarTag Variant="TagVariant.Warning" Appearance="TagAppearance.FilledOutlined">Filled-Outlined</RoarTag>
    <RoarTag Variant="TagVariant.Warning" Appearance="TagAppearance.Filled">Filled</RoarTag>
    <RoarTag Variant="TagVariant.Warning" Appearance="TagAppearance.Outlined">Outlined</RoarTag>
</div>

<div>
    <RoarTag Variant="TagVariant.Danger" Appearance="TagAppearance.Accent">Accent</RoarTag>
    <RoarTag Variant="TagVariant.Danger" Appearance="TagAppearance.FilledOutlined">Filled-Outlined</RoarTag>
    <RoarTag Variant="TagVariant.Danger" Appearance="TagAppearance.Filled">Filled</RoarTag>
    <RoarTag Variant="TagVariant.Danger" Appearance="TagAppearance.Outlined">Outlined</RoarTag>
</div>

<h3>Sizes</h3>
<div>
    <RoarTag Size="TagSize.Xs">Extra Small</RoarTag>
    <RoarTag Size="TagSize.S">Small</RoarTag>
    <RoarTag Size="TagSize.M">Medium</RoarTag>
    <RoarTag Size="TagSize.L">Large</RoarTag>
    <RoarTag Size="TagSize.Xl">Extra Large</RoarTag>
</div>

<h3>Pill</h3>
<div>
    <RoarTag Pill Size="TagSize.Xs">Extra Small</RoarTag>
    <RoarTag Pill Size="TagSize.S">Small</RoarTag>
    <RoarTag Pill Size="TagSize.M">Medium</RoarTag>
    <RoarTag Pill Size="TagSize.L">Large</RoarTag>
    <RoarTag Pill Size="TagSize.Xl">Extra Large</RoarTag>
</div>

<h3>Removable</h3>
<div>
    @foreach (var name in TagNames)
    {
        <RoarTag WithRemove OnRemove="() => TagNames.Remove(name)">@name</RoarTag>
    }
</div>

@code {
    public List<string> TagNames { get; set; } = ["Tag 1", "Tag 2", "Tag 3", "Tag 4", "Tag 5"];
}
