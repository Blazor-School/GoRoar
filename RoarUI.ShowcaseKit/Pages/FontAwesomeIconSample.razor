<h3>Swap Duotone Opacity</h3>
<div>
    Normal duotone
    <RoarIcon Name="home" Family="FontAwesomeFamily.Duotone" />
    <RoarIcon Name="user" Family="FontAwesomeFamily.Duotone" />
    <RoarIcon Name="envelope" Family="FontAwesomeFamily.Duotone" />
    <RoarIcon Name="calendar" Family="FontAwesomeFamily.Duotone" />
</div>
<div>
    Swap duotone
    <RoarIcon Name="home" Family="FontAwesomeFamily.Duotone" SwapOpacity="true" />
    <RoarIcon Name="user" Family="FontAwesomeFamily.Duotone" SwapOpacity="true" />
    <RoarIcon Name="envelope" Family="FontAwesomeFamily.Duotone" SwapOpacity="true" />
    <RoarIcon Name="calendar" Family="FontAwesomeFamily.Duotone" SwapOpacity="true" />
</div>
@code {
    private IconCanvas SelectedCanvas { get; set; } = IconCanvas.Fixed;
    private double CanvasSize { get; set; } = 3;
}
