@namespace RoarUI
@using System.Text.Json
@inherits RoarUI.Components.Input.RoarInputBase<string[]>

<RoarDependency ComponentName="tag-input" />

<wa-tag-input allow-duplicates="@AllowDuplicates" appearance="@Appearance" autocapitalize="@Autocapitalize" autocomplete="@Autocomplete" autocorrect="@(Autocorrect ? "on" : "off")" autofocus="@Autofocus" delimiter="@Delimiter" disabled="@Disabled" enterkeyhint="@EnterKeyHint" hint="@Hint" inputmode="@InputMode" label="@Label" max-tags="@MaxTags" pill="@Pill" placeholder="@Placeholder" readonly="@ReadOnly" size="@Size" spellcheck="@(Spellcheck ? "true" : "false")" with-clear="@WithClear" with-hint="@WithHint" with-label="@WithLabel" @onroarchange="TriggerChangeAsync" @onroarinput="TriggerInputAsync" @onroarcreate="TriggerCreateAsync" @onroarcreate:preventDefault="PreventTagCreation" @onroarclear="TriggerClearAsync" @onroartaginputblur="TriggerBlurAsync" @ref="Element" @attributes="InternalAttributes">
    @ChildContent
</wa-tag-input>

@code {
    /// <summary>
    /// Allows the same tag to be added more than once. By default, duplicates are ignored.
    /// </summary>
    [Parameter]
    public bool AllowDuplicates { get; set; }

    /// <summary>
    /// The tag input's visual appearance.
    /// </summary>
    [Parameter]
    public InputAppearance Appearance { get; set; }

    /// <summary>
    /// Controls whether and how text input is automatically capitalized as it is entered by the user.
    /// </summary>
    [Parameter]
    public InputAutocapitalize? Autocapitalize { get; set; }

    /// <summary>
    /// Specifies what permission the browser has to provide assistance in filling out form field values.
    /// </summary>
    [Parameter]
    public string Autocomplete { get; set; } = "off";

    /// <summary>
    /// Indicates whether the browser's autocorrect feature is on or off. When set as an attribute, use "off" or "on". When set as a property, use true or false.
    /// </summary>
    [Parameter]
    public bool Autocorrect { get; set; }

    /// <summary>
    /// Indicates that the input should receive focus on page load.
    /// </summary>
    [Parameter]
    public bool Autofocus { get; set; }

    /// <summary>
    /// Each character adds a tag when typed or pasted. An empty string allows only Enter and blur to add tags. Default is comma (",").
    /// </summary>
    [Parameter]
    public string Delimiter { get; set; } = ",";

    /// <summary>
    /// Disables the form control.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Used to customize the label or icon of the Enter key on virtual keyboards.
    /// </summary>
    [Parameter]
    public InputEnterKeyHint? EnterKeyHint { get; set; }

    /// <summary>
    /// The tag input's hint. If you need to display HTML, use the hint slot instead.
    /// </summary>
    [Parameter]
    public string Hint { get; set; } = "";

    /// <summary>
    /// Tells the browser what type of data will be entered by the user, allowing it to display the appropriate virtual keyboard on supportive devices.
    /// </summary>
    [Parameter]
    public TagInputInputMode InputMode { get; set; }

    /// <summary>
    /// The text that hasn't become a tag yet. Supports two-way binding independently of Value.
    /// </summary>
    [Parameter]
    public string InputValue { get; set; } = "";

    [Parameter]
    public EventCallback<string> InputValueChanged { get; set; }

    /// <summary>
    /// The tag input's label. If you need to display HTML, use the label slot instead.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>
    /// Limits the number of tags users can add. Null removes the limit.
    /// </summary>
    [Parameter]
    public int? MaxTags { get; set; }

    /// <summary>
    /// Draws a pill-style tag input, and pill-style tags, with rounded edges.
    /// </summary>
    [Parameter]
    public bool Pill { get; set; }

    /// <summary>
    /// Placeholder text to show in the text box. Hidden once the maximum number of tags is reached.
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = "";

    /// <summary>
    /// Rejects user attempts to create tags while true. Does not prevent setting Value directly.
    /// </summary>
    [Parameter]
    public bool PreventTagCreation { get; set; }

    /// <summary>
    /// Makes the tag input readonly. Tags stay visible and are still submitted, but can't be added or removed.
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>
    /// The tag input's size. Also applied to each tag.
    /// </summary>
    [Parameter]
    public InputSize Size { get; set; }

    /// <summary>
    /// Enables spell checking on the text box.
    /// </summary>
    [Parameter]
    public bool Spellcheck { get; set; } = true;

    /// <summary>
    /// Adds a clear button that removes all tags.
    /// </summary>
    [Parameter]
    public bool WithClear { get; set; }

    /// <summary>
    /// Only required for SSR.
    /// </summary>
    [Parameter]
    public bool WithHint { get; set; }

    /// <summary>
    /// Only required for SSR.
    /// </summary>
    [Parameter]
    public bool WithLabel { get; set; }

    /// <summary>
    /// Emitted after the bound tags and unfinished text are updated when a user adds, removes, or clears tags.
    /// </summary>
    [Parameter]
    public EventCallback OnChange { get; set; }

    /// <summary>
    /// Emitted after the bound tags and unfinished text are updated when the user types or changes tags.
    /// </summary>
    [Parameter]
    public EventCallback OnInput { get; set; }

    /// <summary>
    /// Emitted before text becomes a tag, including canceled attempts. Use PreventTagCreation to reject creation synchronously.
    /// </summary>
    [Parameter]
    public EventCallback<TagInputCreateEventArgs> OnCreate { get; set; }

    /// <summary>
    /// Emitted after the clear button removes all tags and updates the bindings.
    /// </summary>
    [Parameter]
    public EventCallback OnClear { get; set; }

    private string _lastTagValue = "[]";
    private string _lastInputValue = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string value = CurrentValueAsString ?? "[]";

        // Send an array directly so tags containing delimiter characters are preserved.
        if (firstRender || !string.Equals(value, _lastTagValue, StringComparison.Ordinal))
        {
            await SetComponentPropertyAsync("value", CurrentValue ?? []);
            _lastTagValue = value;
        }

        if (firstRender || !string.Equals(InputValue, _lastInputValue, StringComparison.Ordinal))
        {
            await SetComponentPropertyAsync("inputValue", InputValue);
            _lastInputValue = InputValue;
        }
    }

    public async Task TriggerChangeAsync(RoarChangeEventArgs args)
    {
        await UpdateValuesAsync(args.TagInput!);
        await OnChange.InvokeAsync();
    }

    public async Task TriggerInputAsync(RoarInputEventArgs args)
    {
        await UpdateValuesAsync(args.TagInput!);
        await OnInput.InvokeAsync();
    }

    public Task TriggerCreateAsync(RoarCreateEventArgs args) => OnCreate.InvokeAsync(args.TagInput);

    public async Task TriggerClearAsync()
    {
        await UpdateValuesAsync(new(await GetComponentPropertyAsync<string[]>("value"), await GetComponentPropertyAsync<string>("inputValue")));
        await OnClear.InvokeAsync();
    }

    private async Task TriggerBlurAsync()
    {
        // Blur also discards rejected text without an input/change event from Web Awesome.
        await UpdateValuesAsync(new(await GetComponentPropertyAsync<string[]>("value"), await GetComponentPropertyAsync<string>("inputValue")));
    }

    private async Task UpdateValuesAsync(TagInputChangeEventArgs args)
    {
        _lastTagValue = JsonSerializer.Serialize(args.Values);
        _lastInputValue = args.InputValue;
        await SetCurrentValueAsStringAsync(_lastTagValue);

        if (!string.Equals(InputValue, args.InputValue, StringComparison.Ordinal))
        {
            InputValue = args.InputValue;
            await InputValueChanged.InvokeAsync(InputValue);
        }
    }

    /// <summary>
    /// Sets focus on the text box.
    /// </summary>
    public ValueTask FocusAsync(bool preventScroll = false) => CallComponentVoidFunctionAsync("focus", new { preventScroll });

    /// <summary>
    /// Removes focus from the text box. Pending text is committed or discarded according to the tag creation rules.
    /// </summary>
    public ValueTask BlurAsync() => CallComponentVoidFunctionAsync("blur");

    protected override string FormatValueAsString(string[]? value) => JsonSerializer.Serialize(value ?? []);

    protected override bool TryParseValueFromString(string? value, out string[] result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        string[] values = JsonSerializer.Deserialize<string[]>(value ?? "[]") ?? [];
        result = Value is not null && Value.SequenceEqual(values) ? Value : values;
        validationErrorMessage = null;
        return true;
    }
}
