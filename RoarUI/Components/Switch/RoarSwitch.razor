@namespace RoarUI
@inherits RoarUI.Components.Input.RoarInputBase<bool>

<RoarDependency ComponentName="switch" />

<wa-switch checked="@CurrentValue" disabled="@Disabled" hint="@Hint" size="@Size" with-hint="@WithHint" @onroarchange="TriggerChangeAsync" @onroarinput="TriggerInputAsync" @ref="Element" @attributes="InternalAttributes">
    @ChildContent
</wa-switch>

@code {
    /// <summary>
    /// The width of the switch. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? Width { get; set; }

    /// <summary>
    /// The height of the switch. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? Height { get; set; }

    /// <summary>
    /// The size of the thumb. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? ThumbSize { get; set; }

    /// <summary>
    /// Disables the switch.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// The switch's hint. Use the hint slot for HTML.
    /// </summary>
    [Parameter]
    public string Hint { get; set; } = "";

    /// <summary>
    /// The switch's size.
    /// </summary>
    [Parameter]
    public SwitchSize Size { get; set; }

    /// <summary>
    /// Includes the hint slot in server-rendered markup.
    /// </summary>
    [Parameter]
    public bool WithHint { get; set; }

    /// <summary>
    /// Emitted when the checked state changes.
    /// </summary>
    [Parameter]
    public EventCallback OnChange { get; set; }

    /// <summary>
    /// Emitted when the switch receives input.
    /// </summary>
    [Parameter]
    public EventCallback OnInput { get; set; }

    public async Task TriggerChangeAsync(RoarChangeEventArgs args)
    {
        await SetCurrentValueAsync(args.Switch!.Checked);
        await OnChange.InvokeAsync();
    }

    public async Task TriggerInputAsync(RoarInputEventArgs args)
    {
        await SetCurrentValueAsync(args.Switch!.Checked);
        await OnInput.InvokeAsync();
    }

    /// <summary>
    /// Removes focus from the switch.
    /// </summary>
    public ValueTask BlurAsync() => CallComponentVoidFunctionAsync("blur");

    /// <summary>
    /// Simulates a click on the switch.
    /// </summary>
    public ValueTask ClickAsync() => CallComponentVoidFunctionAsync("click");

    /// <summary>
    /// Sets focus on the switch.
    /// </summary>
    public ValueTask FocusAsync(bool preventScroll = false, bool focusVisible = true) => CallComponentVoidFunctionAsync("focus", new { preventScroll, focusVisible });

    protected override bool TryParseValueFromString(string? value, out bool result, [NotNullWhen(false)] out string? validationErrorMessage) => throw new NotSupportedException($"This component does not parse string inputs. Bind to the '{nameof(CurrentValue)}' property, not '{nameof(CurrentValueAsString)}'.");

    internal override AttributeBuilder InitializeAttributeBuilder() => base.InitializeAttributeBuilder()
        .AddStyle("--width", Width)
        .AddStyle("--height", Height)
        .AddStyle("--thumb-size", ThumbSize);
}
