@namespace RoarUI
@inherits RoarJsComponentBase

<RoarDependency ComponentName="button" />

<wa-button href="@Href" target="@Target" variant="@Variant" appearance="@Appearance" size="@Size" pill="@Pill" @ref="Element" @attributes="InternalAttributes">@ChildContent</wa-button>

@code {
    private Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .MapEvent("onblur", "onroarblur")
            .MapEvent("onfocus", "onroarfocus")
            .Build();
    }

    /// <summary>
    /// The button's theme variant. Defaults to <see cref="Variant.Neutral"/> if not within another element with a variant.
    /// </summary>
    [Parameter]
    public ButtonVariant Variant { get; set; }

    /// <summary>
    /// The button's visual appearance.
    /// </summary>
    [Parameter]
    public ButtonAppearance Appearance { get; set; }

    /// <summary>
    /// The button's size.
    /// </summary>
    [Parameter]
    public ButtonSize Size { get; set; }

    /// <summary>
    /// Draws a pill-style button with rounded edges.
    /// </summary>
    [Parameter]
    public bool Pill { get; set; }

    /// <summary>
    /// The link's URL.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public string Href { get; set; } = "";

    /// <summary>
    /// Tells the browser where to open the link.
    /// </summary>
    [Parameter]
    public LinkTarget Target { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Removes focus from the button.
    /// </summary>
    public ValueTask BlurAsync() => CallComponentVoidFunctionAsync("blur");

    /// <summary>
    /// Sets focus on the button.
    /// <a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/focus#options">https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/focus#options</a>
    /// </summary>
    public ValueTask FocusAsync(bool preventScroll = false, bool focusVisible = true) => CallComponentVoidFunctionAsync("focus", new { preventScroll, focusVisible });
}
