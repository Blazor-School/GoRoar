@code {
    private const string SharedSelectors = ":where(:root), .wa-theme-default, .wa-light, .wa-dark, .wa-invert";
    private const string LightSelectors = ":where(:root), .wa-theme-default, .wa-light, .wa-dark .wa-invert, .wa-light .wa-theme-default, .wa-dark .wa-theme-default.wa-invert, .wa-dark .wa-theme-default .wa-invert";
    private const string DarkSelectors = ".wa-dark, .wa-invert, .wa-dark .wa-theme-default, .wa-light .wa-theme-default.wa-invert, .wa-light .wa-theme-default .wa-invert";
    private const string InitialModeSelector = ":root:where(:not(.wa-light):not(.wa-dark))";
    private static readonly HashSet<string> BuiltInVariants = [RoarVariant.Brand, RoarVariant.Neutral, RoarVariant.Success, RoarVariant.Warning, RoarVariant.Danger];
    private static readonly VariantColors CustomVariantPaletteDefaults = new()
    {
        Color95 = "var(--wa-color-blue-95)",
        Color90 = "var(--wa-color-blue-90)",
        Color80 = "var(--wa-color-blue-80)",
        Color70 = "var(--wa-color-blue-70)",
        Color60 = "var(--wa-color-blue-60)",
        Color50 = "var(--wa-color-blue-50)",
        Color40 = "var(--wa-color-blue-40)",
        Color30 = "var(--wa-color-blue-30)",
        Color20 = "var(--wa-color-blue-20)",
        Color10 = "var(--wa-color-blue-10)",
        Color05 = "var(--wa-color-blue-05)",
        Color = "var(--wa-color-blue)",
        On = "var(--wa-color-blue-on)"
    };

    private string ActiveSchemeName => ThemeService.Mode == ThemeMode.Dark ? "dark" : "light";

    private string GetModeSelectors(string name)
    {
        var selectors = name == "light" ? LightSelectors : DarkSelectors;
        var modeSelector = $".wa-{ActiveSchemeName}";
        // Give a classless root the same specificity and descendant behavior as the active mode class.
        var initialSelectors = selectors.Split(", ").Where(selector => selector.Contains(modeSelector, StringComparison.Ordinal)).Select(selector => selector.Replace(modeSelector, InitialModeSelector, StringComparison.Ordinal));

        return $"{selectors}, {string.Join(", ", initialSelectors)}";
    }

    private RenderFragment RenderScheme(SchemeColors scheme, SchemeColors otherScheme, Dictionary<string, VariantColors> variants)
    {
        var selectors = GetModeSelectors(scheme.Name);
        var isLight = scheme.Name == "light";

        return @<style data-roar-color-scheme="@scheme.Name">
            @@layer wa-theme-overrides {
            @selectors {
            color-scheme: @RenderCssValue(scheme.Name);
            color: var(--wa-color-text-normal);
            @RenderSchemeProperty("--wa-color-surface-raised", scheme.SurfaceRaised, otherScheme.SurfaceRaised)
            @RenderSchemeProperty("--wa-color-surface-default", scheme.SurfaceDefault, otherScheme.SurfaceDefault)
            @RenderSchemeProperty("--wa-color-surface-lowered", scheme.SurfaceLowered, otherScheme.SurfaceLowered)
            @RenderSchemeProperty("--wa-color-surface-border", scheme.SurfaceBorder, otherScheme.SurfaceBorder)
            @RenderSchemeProperty("--wa-color-text-normal", scheme.TextNormal, otherScheme.TextNormal)
            @RenderSchemeProperty("--wa-color-text-quiet", scheme.TextQuiet, otherScheme.TextQuiet)
            @RenderSchemeProperty("--wa-color-text-link", scheme.TextLink, otherScheme.TextLink)
            @RenderSchemeProperty("--wa-color-overlay-modal", scheme.OverlayModal, otherScheme.OverlayModal)
            @RenderSchemeProperty("--wa-color-overlay-inline", scheme.OverlayInline, otherScheme.OverlayInline)
            @RenderSchemeProperty("--wa-color-shadow", scheme.Shadow, otherScheme.Shadow)
            @RenderSchemeProperty("--wa-color-focus", scheme.Focus, otherScheme.Focus)
            @RenderSchemeProperty("--wa-color-mix-hover", scheme.MixHover, otherScheme.MixHover)
            @RenderSchemeProperty("--wa-color-mix-active", scheme.MixActive, otherScheme.MixActive)
            @foreach (var variant in variants)
            {
                var appearance = isLight ? variant.Value.Light : variant.Value.Dark;
                var otherAppearance = isLight ? variant.Value.Dark : variant.Value.Light;
                var appearanceDefaults = BuiltInVariants.Contains(variant.Key) ? null : GetCustomVariantAppearanceDefaults(variant.Key, isLight);

                <text>
                @RenderSchemeProperty($"--wa-color-{variant.Key}-fill-quiet", appearance?.FillQuiet ?? appearanceDefaults?.FillQuiet, otherAppearance?.FillQuiet)
                @RenderSchemeProperty($"--wa-color-{variant.Key}-fill-normal", appearance?.FillNormal ?? appearanceDefaults?.FillNormal, otherAppearance?.FillNormal)
                @RenderSchemeProperty($"--wa-color-{variant.Key}-fill-loud", appearance?.FillLoud ?? appearanceDefaults?.FillLoud, otherAppearance?.FillLoud)
                @RenderSchemeProperty($"--wa-color-{variant.Key}-border-quiet", appearance?.BorderQuiet ?? appearanceDefaults?.BorderQuiet, otherAppearance?.BorderQuiet)
                @RenderSchemeProperty($"--wa-color-{variant.Key}-border-normal", appearance?.BorderNormal ?? appearanceDefaults?.BorderNormal, otherAppearance?.BorderNormal)
                @RenderSchemeProperty($"--wa-color-{variant.Key}-border-loud", appearance?.BorderLoud ?? appearanceDefaults?.BorderLoud, otherAppearance?.BorderLoud)
                @RenderSchemeProperty($"--wa-color-{variant.Key}-on-quiet", appearance?.OnQuiet ?? appearanceDefaults?.OnQuiet, otherAppearance?.OnQuiet)
                @RenderSchemeProperty($"--wa-color-{variant.Key}-on-normal", appearance?.OnNormal ?? appearanceDefaults?.OnNormal, otherAppearance?.OnNormal)
                @RenderSchemeProperty($"--wa-color-{variant.Key}-on-loud", appearance?.OnLoud ?? appearanceDefaults?.OnLoud, otherAppearance?.OnLoud)
                </text>
            }
            }
            }
        </style>;
    }

    private static VariantSchemeColors GetCustomVariantAppearanceDefaults(string variant, bool isLight) => new()
    {
        FillQuiet = $"var(--wa-color-{variant}-{(isLight ? "95" : "10")})",
        FillNormal = $"var(--wa-color-{variant}-{(isLight ? "90" : "20")})",
        FillLoud = $"var(--wa-color-{variant}-50)",
        BorderQuiet = $"var(--wa-color-{variant}-{(isLight ? "90" : "20")})",
        BorderNormal = $"var(--wa-color-{variant}-{(isLight ? "80" : "30")})",
        BorderLoud = $"var(--wa-color-{variant}-{(isLight ? "60" : "40")})",
        OnQuiet = $"var(--wa-color-{variant}-{(isLight ? "40" : "60")})",
        OnNormal = $"var(--wa-color-{variant}-{(isLight ? "30" : "70")})",
        OnLoud = "white"
    };

    private static MarkupString RenderSchemeProperty(string property, string? value, string? otherValue) => RenderCssProperty(property, value ?? (otherValue is null ? null : "revert-layer"));
    private static MarkupString RenderCssProperty(string property, string? value) => value is null ? default : RenderCssValue($"{property}: {value};");

    private static MarkupString RenderCssValue(string? value)
    {
        return new MarkupString(value?.Replace("</", "\\3c /", StringComparison.Ordinal) ?? string.Empty);
    }

    private MarkupString BuildVariantMappings(IEnumerable<string> variants)
    {
        var css = new System.Text.StringBuilder();

        foreach (var variant in variants)
        {
            foreach (var renderer in VariantCssRenderers)
            {
                css.AppendLine(renderer.BuildVariantMappings(variant));
            }
        }

        return RenderCssValue(css.ToString());
    }

    protected override void OnInitialized()
    {
        RoarDependencyService.OnComponentsChanged += OnComponentsChangedHandler;
        ThemeService.OnThemeLoaded += OnThemeLoadedHandler;
        ThemeService.OnModeChanged += OnModeChangedHandler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("applyMode", ActiveSchemeName);
        }
    }

    public void OnComponentsChangedHandler(object? sender, EventArgs args)
    {
        InvokeAsync(StateHasChanged);
    }

    public void OnThemeLoadedHandler(object? sender, RoarTheme? theme)
    {
        InvokeAsync(StateHasChanged);
    }

    public void OnModeChangedHandler(object? sender, ThemeMode mode)
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();

            try
            {
                await JSRuntime.InvokeVoidAsync("applyMode", ActiveSchemeName);
            }
            catch (InvalidOperationException)
            {
            }
        });
    }

    public void Dispose()
    {
        RoarDependencyService.OnComponentsChanged -= OnComponentsChangedHandler;
        ThemeService.OnThemeLoaded -= OnThemeLoadedHandler;
        ThemeService.OnModeChanged -= OnModeChangedHandler;
    }
}
