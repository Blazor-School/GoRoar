@namespace RoarUI
@using System.Text
@inject RoarDependencyService RoarDependencyService
@inject ThemeService ThemeService
@inject IJSRuntime JSRuntime
@inject IEnumerable<RoarUI.Theme.IVariantCssRenderer> VariantCssRenderers
@implements IDisposable
@attribute [StreamRendering(false)]

<link rel="stylesheet" href="@($"{InternalPaths.BaseWebAwesomePath}/styles/webawesome.css")" />

@foreach (var component in RoarDependencyService.Components)
{
    <script type="module" src="@InternalPaths.ComposeComponentJsPath(component)"></script>
}

@{
    var tokens = ThemeService.CurrentTheme.Tokens;
    var themeCss = BuildThemeCss(tokens);
    var variantMappings = BuildVariantMappings(tokens.Variants.Keys.Where(name => !DefaultTokens.Variants.ContainsKey(name)));
}

@if (variantMappings.Length > 0)
{
    <style>
        @@layer wa-theme-overrides {
        @RenderCssValue(variantMappings)
        }
    </style>
}

@if (themeCss.Length > 0)
{
    <style>
        @@layer wa-theme-overrides {
        @RenderCssValue(themeCss)
        }
    </style>
}

@code {
    private const string SharedSelectors = ":where(:root), .wa-theme-default, .wa-light, .wa-dark, .wa-invert";
    private const string LightSelectors = ":where(:root), .wa-theme-default, .wa-light, .wa-dark .wa-invert, .wa-light .wa-theme-default, .wa-dark .wa-theme-default.wa-invert, .wa-dark .wa-theme-default .wa-invert";
    private const string DarkSelectors = ".wa-dark, .wa-invert, .wa-dark .wa-theme-default, .wa-light .wa-theme-default.wa-invert, .wa-light .wa-theme-default .wa-invert";
    private const string InitialModeSelector = ":root:where(:not(.wa-light):not(.wa-dark))";
    private static readonly ThemeTokens DefaultTokens = new();
    private string ActiveSchemeName => ThemeService.Mode == ThemeMode.Dark ? "dark" : "light";

    private string GetModeSelectors(string name)
    {
        var selectors = name == "light" ? LightSelectors : DarkSelectors;
        var modeSelector = $".wa-{ActiveSchemeName}";
        // Give a classless root the same specificity and descendant behavior as the active mode class.
        var initialSelectors = selectors.Split(", ").Where(selector => selector.Contains(modeSelector, StringComparison.Ordinal)).Select(selector => selector.Replace(modeSelector, InitialModeSelector, StringComparison.Ordinal));

        return $"{selectors}, {string.Join(", ", initialSelectors)}";
    }

    private string BuildThemeCss(ThemeTokens tokens)
    {
        var css = new StringBuilder();
        AppendCssRule(css, SharedSelectors, BuildSharedCss(tokens));
        AppendCssRule(css, ":where(:root)", BuildPaletteCss(tokens));
        AppendCssRule(css, GetModeSelectors(tokens.Light.Name), BuildSchemeCss(tokens.Light, DefaultTokens.Light, tokens.Dark, DefaultTokens.Dark, tokens.Variants));
        AppendCssRule(css, GetModeSelectors(tokens.Dark.Name), BuildSchemeCss(tokens.Dark, DefaultTokens.Dark, tokens.Light, DefaultTokens.Light, tokens.Variants));

        return css.ToString();
    }

