        @RenderCssProperty("--wa-border-radius-square", tokens.Border.RadiusSquare)
        @RenderCssProperty("--wa-border-radius-s", tokens.Border.RadiusS)
        @RenderCssProperty("--wa-border-radius-m", tokens.Border.RadiusM)
        @RenderCssProperty("--wa-border-radius-l", tokens.Border.RadiusL)
        /* ### End border section ### */
