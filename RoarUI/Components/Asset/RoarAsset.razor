@code {
    private static readonly IReadOnlyDictionary<string, Theme.VariantPalette> DefaultVariants = new Theme.Token().Variants;

    private static MarkupString RenderCssValue(string? value)
    {
        return new MarkupString(value?.Replace("</", "\\3c /", StringComparison.Ordinal) ?? string.Empty);
    }

    private MarkupString BuildVariantMappings(IEnumerable<string> variants)
    {
        var css = new System.Text.StringBuilder();

        foreach (var variant in variants)
        {
            foreach (var renderer in VariantCssRenderers)
            {
                css.AppendLine(renderer.BuildVariantMappings(variant));
            }
        }

        return RenderCssValue(css.ToString());
    }

    protected override void OnInitialized()
    {
        RoarDependencyService.OnComponentsChanged += OnComponentsChangedHandler;
        ThemeService.OnThemeLoaded += OnThemeLoadedHandler;
    }

    public void OnComponentsChangedHandler(object? sender, EventArgs args)
    {
        InvokeAsync(StateHasChanged);
    }

    public void OnThemeLoadedHandler(object? sender, RoarTheme? theme)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        RoarDependencyService.OnComponentsChanged -= OnComponentsChangedHandler;
        ThemeService.OnThemeLoaded -= OnThemeLoadedHandler;
    }
}
