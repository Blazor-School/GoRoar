    private static StringBuilder BuildSchemeCss(SchemeColors scheme, SchemeColors defaults, SchemeColors otherScheme, SchemeColors otherDefaults, Dictionary<string, VariantColors> variants)
    {
        var css = new StringBuilder();
        var isLight = scheme.Name == "light";

        AppendSchemeProperty(css, "--wa-color-surface-raised", scheme.SurfaceRaised, defaults.SurfaceRaised, otherScheme.SurfaceRaised, otherDefaults.SurfaceRaised);
        AppendSchemeProperty(css, "--wa-color-surface-default", scheme.SurfaceDefault, defaults.SurfaceDefault, otherScheme.SurfaceDefault, otherDefaults.SurfaceDefault);
        AppendSchemeProperty(css, "--wa-color-surface-lowered", scheme.SurfaceLowered, defaults.SurfaceLowered, otherScheme.SurfaceLowered, otherDefaults.SurfaceLowered);
        AppendSchemeProperty(css, "--wa-color-surface-border", scheme.SurfaceBorder, defaults.SurfaceBorder, otherScheme.SurfaceBorder, otherDefaults.SurfaceBorder);
        AppendSchemeProperty(css, "--wa-color-text-normal", scheme.TextNormal, defaults.TextNormal, otherScheme.TextNormal, otherDefaults.TextNormal);
        AppendSchemeProperty(css, "--wa-color-text-quiet", scheme.TextQuiet, defaults.TextQuiet, otherScheme.TextQuiet, otherDefaults.TextQuiet);
        AppendSchemeProperty(css, "--wa-color-text-link", scheme.TextLink, defaults.TextLink, otherScheme.TextLink, otherDefaults.TextLink);
        AppendSchemeProperty(css, "--wa-color-overlay-modal", scheme.OverlayModal, defaults.OverlayModal, otherScheme.OverlayModal, otherDefaults.OverlayModal);
        AppendSchemeProperty(css, "--wa-color-overlay-inline", scheme.OverlayInline, defaults.OverlayInline, otherScheme.OverlayInline, otherDefaults.OverlayInline);
        AppendSchemeProperty(css, "--wa-color-shadow", scheme.Shadow, defaults.Shadow, otherScheme.Shadow, otherDefaults.Shadow);
        AppendSchemeProperty(css, "--wa-color-focus", scheme.Focus, defaults.Focus, otherScheme.Focus, otherDefaults.Focus);
        AppendSchemeProperty(css, "--wa-color-mix-hover", scheme.MixHover, defaults.MixHover, otherScheme.MixHover, otherDefaults.MixHover);
        AppendSchemeProperty(css, "--wa-color-mix-active", scheme.MixActive, defaults.MixActive, otherScheme.MixActive, otherDefaults.MixActive);

        foreach (var (name, variant) in variants)
        {
            var variantDefaults = DefaultTokens.Variants.GetValueOrDefault(name);
            var appearance = isLight ? variant.Light : variant.Dark;
            var otherAppearance = isLight ? variant.Dark : variant.Light;
            var appearanceDefaults = isLight ? variantDefaults?.Light : variantDefaults?.Dark;
            var otherAppearanceDefaults = isLight ? variantDefaults?.Dark : variantDefaults?.Light;
            var fallback = variantDefaults is null ? GetCustomVariantAppearanceDefaults(name, isLight) : null;

            AppendSchemeProperty(css, $"--wa-color-{name}-fill-quiet", appearance?.FillQuiet ?? fallback?.FillQuiet, appearanceDefaults?.FillQuiet, otherAppearance?.FillQuiet, otherAppearanceDefaults?.FillQuiet);
            AppendSchemeProperty(css, $"--wa-color-{name}-fill-normal", appearance?.FillNormal ?? fallback?.FillNormal, appearanceDefaults?.FillNormal, otherAppearance?.FillNormal, otherAppearanceDefaults?.FillNormal);
            AppendSchemeProperty(css, $"--wa-color-{name}-fill-loud", appearance?.FillLoud ?? fallback?.FillLoud, appearanceDefaults?.FillLoud, otherAppearance?.FillLoud, otherAppearanceDefaults?.FillLoud);
            AppendSchemeProperty(css, $"--wa-color-{name}-border-quiet", appearance?.BorderQuiet ?? fallback?.BorderQuiet, appearanceDefaults?.BorderQuiet, otherAppearance?.BorderQuiet, otherAppearanceDefaults?.BorderQuiet);
            AppendSchemeProperty(css, $"--wa-color-{name}-border-normal", appearance?.BorderNormal ?? fallback?.BorderNormal, appearanceDefaults?.BorderNormal, otherAppearance?.BorderNormal, otherAppearanceDefaults?.BorderNormal);
            AppendSchemeProperty(css, $"--wa-color-{name}-border-loud", appearance?.BorderLoud ?? fallback?.BorderLoud, appearanceDefaults?.BorderLoud, otherAppearance?.BorderLoud, otherAppearanceDefaults?.BorderLoud);
            AppendSchemeProperty(css, $"--wa-color-{name}-on-quiet", appearance?.OnQuiet ?? fallback?.OnQuiet, appearanceDefaults?.OnQuiet, otherAppearance?.OnQuiet, otherAppearanceDefaults?.OnQuiet);
            AppendSchemeProperty(css, $"--wa-color-{name}-on-normal", appearance?.OnNormal ?? fallback?.OnNormal, appearanceDefaults?.OnNormal, otherAppearance?.OnNormal, otherAppearanceDefaults?.OnNormal);
            AppendSchemeProperty(css, $"--wa-color-{name}-on-loud", appearance?.OnLoud ?? fallback?.OnLoud, appearanceDefaults?.OnLoud, otherAppearance?.OnLoud, otherAppearanceDefaults?.OnLoud);
        }

        return css;
    }

    private static VariantSchemeColors GetCustomVariantAppearanceDefaults(string variant, bool isLight) => new()
    {
        FillQuiet = $"var(--wa-color-{variant}-{(isLight ? "95" : "10")})",
        FillNormal = $"var(--wa-color-{variant}-{(isLight ? "90" : "20")})",
        FillLoud = $"var(--wa-color-{variant}-50)",
        BorderQuiet = $"var(--wa-color-{variant}-{(isLight ? "90" : "20")})",
        BorderNormal = $"var(--wa-color-{variant}-{(isLight ? "80" : "30")})",
        BorderLoud = $"var(--wa-color-{variant}-{(isLight ? "60" : "40")})",
        OnQuiet = $"var(--wa-color-{variant}-{(isLight ? "40" : "60")})",
        OnNormal = $"var(--wa-color-{variant}-{(isLight ? "30" : "70")})",
        OnLoud = "white"
    };

    private static void AppendSchemeProperty(StringBuilder css, string property, string? value, string? defaultValue, string? otherValue, string? otherDefault)
    {
        var overrideValue = GetOverride(value, defaultValue);
        if (overrideValue is null && GetOverride(otherValue, otherDefault) is not null)
        {
            overrideValue = "revert-layer";
        }

        AppendCssProperty(css, property, overrideValue, null);
    }

    private static string? GetOverride(string? value, string? defaultValue) => string.Equals(value, defaultValue, StringComparison.Ordinal) ? null : value;

    private static void AppendCssProperty(StringBuilder css, string property, string? value, string? defaultValue)
    {
        if (GetOverride(value, defaultValue) is { } overrideValue)
        {
            css.AppendLine($"{property}: {overrideValue};");
        }
    }

    private static void AppendCssRule(StringBuilder css, string selectors, StringBuilder declarations)
    {
        if (declarations.Length > 0)
        {
            css.AppendLine($"{selectors} {{");
            css.Append(declarations);
            css.AppendLine("}");
        }
    }

    private static MarkupString RenderCssValue(string? value)
    {
        return new MarkupString(value?.Replace("</", "\\3c /", StringComparison.Ordinal) ?? string.Empty);
    }

    private string BuildVariantMappings(IEnumerable<string> variants)
    {
        var css = new StringBuilder();

        foreach (var variant in variants)
        {
            foreach (var renderer in VariantCssRenderers)
            {
                css.Append(renderer.BuildVariantMappings(variant));
            }
        }

        return css.ToString();
    }

    protected override void OnInitialized()
    {
        RoarDependencyService.OnComponentsChanged += OnComponentsChangedHandler;
        ThemeService.OnThemeLoaded += OnThemeLoadedHandler;
        ThemeService.OnModeChanged += OnModeChangedHandler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("applyMode", ActiveSchemeName);
        }
    }

    public void OnComponentsChangedHandler(object? sender, EventArgs args)
    {
        InvokeAsync(StateHasChanged);
    }

    public void OnThemeLoadedHandler(object? sender, RoarTheme? theme)
    {
        InvokeAsync(StateHasChanged);
    }

    public void OnModeChangedHandler(object? sender, ThemeMode mode)
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();

            try
            {
                await JSRuntime.InvokeVoidAsync("applyMode", ActiveSchemeName);
            }
            catch (InvalidOperationException)
            {
            }
        });
    }

    public void Dispose()
    {
        RoarDependencyService.OnComponentsChanged -= OnComponentsChangedHandler;
        ThemeService.OnThemeLoaded -= OnThemeLoadedHandler;
        ThemeService.OnModeChanged -= OnModeChangedHandler;
    }
}
