@namespace RoarUI
@inject RoarDependencyService RoarDependencyService
@inject ThemeService ThemeService
@inject IEnumerable<RoarUI.Theme.IVariantCssRenderer> VariantCssRenderers
@implements IDisposable
@attribute [StreamRendering(false)]

<link rel="stylesheet" href="@($"{InternalPaths.BaseWebAwesomePath}/styles/webawesome.css")" />

@foreach (var component in RoarDependencyService.Components)
{
    <script type="module" src="@InternalPaths.ComposeComponentJsPath(component)"></script>
}

