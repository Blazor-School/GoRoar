        @RenderCssProperty("--wa-color-cyan-80", tokens.Palette.Cyan80)
        @RenderCssProperty("--wa-color-cyan-70", tokens.Palette.Cyan70)
        @RenderCssProperty("--wa-color-cyan-60", tokens.Palette.Cyan60)
        @RenderCssProperty("--wa-color-cyan-50", tokens.Palette.Cyan50)
        @RenderCssProperty("--wa-color-cyan-40", tokens.Palette.Cyan40)
