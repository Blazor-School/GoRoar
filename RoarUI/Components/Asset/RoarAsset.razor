@namespace RoarUI
@inject RoarDependencyService RoarDependencyService
@inject ThemeService ThemeService
@inject IJSRuntime JSRuntime
@inject IEnumerable<RoarUI.Theme.IVariantCssRenderer> VariantCssRenderers
@implements IDisposable
@attribute [StreamRendering(false)]

<link rel="stylesheet" href="@($"{InternalPaths.BaseWebAwesomePath}/styles/webawesome.css")" />

@foreach (var component in RoarDependencyService.Components)
{
    <script type="module" src="@InternalPaths.ComposeComponentJsPath(component)"></script>
}

@if (ThemeService.CustomTheme is { } customTheme)
{
    var tokens = customTheme.Tokens;
    var variantMappings = BuildVariantMappings(tokens.Variants.Keys);

    <style data-roar-variant-mappings>
        @@layer wa-theme-overrides {
        @variantMappings
        }
    </style>
    <style>
        @@layer wa-theme-overrides {
        @SharedSelectors {
        /* ### Start border section ### */
        @RenderCssProperty("--wa-border-style", tokens.Border.Style)
        @RenderCssProperty("--wa-border-width-s", tokens.Border.WidthS)
        @RenderCssProperty("--wa-border-width-m", tokens.Border.WidthM)
        @RenderCssProperty("--wa-border-width-l", tokens.Border.WidthL)
