            --wa-color-@(variant.Key)-95: @RenderCssValue(variant.Value.Color95 ?? colorDefaults.Color95);
            --wa-color-@(variant.Key)-90: @RenderCssValue(variant.Value.Color90 ?? colorDefaults.Color90);
            --wa-color-@(variant.Key)-80: @RenderCssValue(variant.Value.Color80 ?? colorDefaults.Color80);
