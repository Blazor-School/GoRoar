@namespace RoarUI

<RoarDependency ComponentName="progress-bar" />

<wa-progress-bar indeterminate="@Indeterminate" label="@Label" value="@Value" @attributes="InternalAttributes">
    @ChildContent
</wa-progress-bar>

@code {
    /// <summary>
    /// The height of the track. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? TrackHeight { get; set; }

    /// <summary>
    /// The color of the track. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? TrackColor { get; set; }

    /// <summary>
    /// The color of the indicator. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? IndicatorColor { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// When true, percentage is ignored, the label is hidden, and the progress bar is drawn in an indeterminate state.
    /// </summary>
    [Parameter]
    public bool Indeterminate { get; set; } = false;

    /// <summary>
    /// A custom label for assistive devices.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>
    /// The current progress as a percentage, 0 to 100.
    /// </summary>
    [Parameter]
    public int Value { get; set; } = 0;

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--track-height", TrackHeight)
            .AddStyle("--track-color", TrackColor)
            .AddStyle("--indicator-color", IndicatorColor)
            .Build();
    }
}
