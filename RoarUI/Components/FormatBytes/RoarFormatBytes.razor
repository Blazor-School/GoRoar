@namespace RoarUI
@using System.Globalization

<RoarDependency ComponentName="format-bytes" />

<wa-format-bytes value="@Value.ToString(CultureInfo.InvariantCulture)" unit="@Unit" display="@Display" @attributes="AdditionalAttributes"></wa-format-bytes>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The number to format.
    /// </summary>
    [Parameter]
    public double Value { get; set; } = 0;

    /// <summary>
    /// The type of unit to display.
    /// </summary>
    [Parameter]
    public FormatBytesUnit Unit { get; set; }

    /// <summary>
    /// Determines whether to display long, short, or narrow unit names.
    /// </summary>
    [Parameter]
    public FormatBytesDisplay Display { get; set; }
}
