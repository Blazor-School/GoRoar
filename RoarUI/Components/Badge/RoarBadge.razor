@namespace RoarUI

<RoarDependency ComponentName="badge" />

<wa-badge variant="@Variant" appearance="@Appearance" pill="@Pill" attention="@Attention" @attributes="InternalAttributes">@ChildContent</wa-badge>

@code {
    /// <summary>
    /// The color of the badge's pulse effect when using <c>attention="pulse"</c>. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? PulseColor { get; set; }

    /// <summary>
    /// The badge's theme variant. Defaults to brand if not within another element with a variant.
    /// </summary>
    [Parameter]
    public BadgeVariant Variant { get; set; }

    /// <summary>
    /// The badge's visual appearance.
    /// </summary>
    [Parameter]
    public BadgeAppearance Appearance { get; set; }

    /// <summary>
    /// The badge's size. Can use any valid CSS unit. When omitted, the size is controlled by CSS.
    /// </summary>
    [Parameter]
    public BadgeSize? Size { get; set; }

    /// <summary>
    /// Draws a pill-style badge with rounded edges.
    /// </summary>
    [Parameter]
    public bool Pill { get; set; } = false;

    /// <summary>
    /// Adds an animation to draw attention to the badge.
    /// </summary>
    [Parameter]
    public BadgeAttention Attention { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("font-size", Size?.Value)
            .AddStyle("--pulse-color", PulseColor)
            .Build();
    }
}
