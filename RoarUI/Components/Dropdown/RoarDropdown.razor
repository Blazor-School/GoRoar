@namespace RoarUI
@inherits RoarJsEventComponentBase

<RoarDependency ComponentName="dropdown" />

<wa-dropdown distance="@Distance" open="@Open" placement="@Placement" size="@Size" skidding="@Skidding" @ref="Element" @attributes="InternalAttributes">
    @ChildContent
</wa-dropdown>

@code {
    /// <summary>
    /// The distance of the dropdown menu from its trigger.
    /// </summary>
    [Parameter]
    public double Distance { get; set; }

    /// <summary>
    /// Opens or closes the dropdown.
    /// </summary>
    [Parameter]
    public bool Open { get; set; } = false;

    /// <summary>
    /// Gets or sets a callback that updates the bound open.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Gets or sets an expression that identifies the bound open.
    /// </summary>
    [Parameter]
    public Expression<Func<bool>>? OpenExpression { get; set; }

    /// <summary>
    /// The placement of the dropdown menu in reference to the trigger. The menu will shift to a more optimal location if the preferred placement doesn't have enough room.
    /// </summary>
    [Parameter]
    public DropdownPlacement Placement { get; set; }

    /// <summary>
    /// The dropdown's size.
    /// </summary>
    [Parameter]
    public DropdownSize Size { get; set; }

    /// <summary>
    /// The offset of the dropdown menu along its trigger.
    /// </summary>
    [Parameter]
    public int Skidding { get; set; }

    /// <summary>
    /// Gets or sets the value of the input. This should be used with two-way binding.
    /// </summary>
    /// <example>
    /// @bind-Value="model.PropertyName"
    /// </example>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets a callback that updates the bound value.
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets an expression that identifies the bound value.
    /// </summary>
    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>
    /// When true, the dropdown will remain open after an item is selected. When false, the dropdown will be closed after an item is selected.
    /// </summary>
    [Parameter]
    public bool OnSelectPreventDefault { get; set; }

    /// <summary>
    /// Stop propagation of the select event.
    /// </summary>
    [Parameter]
    public bool OnSelectStopPropagation { get; set; }

    /// <summary>
    /// Emitted when the dropdown is about to hide.
    /// </summary>
    [Parameter]
    public EventCallback OnHide { get; set; }

    /// <summary>
    /// Emitted after the dropdown has been hidden.
    /// </summary>
    [Parameter]
    public EventCallback OnAfterHide { get; set; }

    /// <summary>
    /// Emitted when the dropdown is about to show.
    /// </summary>
    [Parameter]
    public EventCallback OnShow { get; set; }

    /// <summary>
    /// Emitted after the dropdown has been shown.
    /// </summary>
    [Parameter]
    public EventCallback OnAfterShow { get; set; }

    /// <summary>
    /// The checkbox items with its state
    /// </summary>
    [Parameter]
    public EventCallback<KeyValuePair<string?, bool>> CheckboxItemSelected { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddEventModifier("wa-select", EventModifier.PreventDefault, OnSelectPreventDefault)
            .AddEventModifier("wa-select", EventModifier.StopPropagation, OnSelectStopPropagation)
            .Build();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RegisterEventAsync("wa-select", nameof(DropdownSelectEventArgs), nameof(NotifyValueChanged));
            await RegisterEventAsync("wa-after-hide", nameof(TriggerAfterHideAsync));
            await RegisterEventAsync("wa-after-show", nameof(TriggerAfterShowAsync));
            await RegisterEventAsync("wa-hide", nameof(TriggerHideAsync));
            await RegisterEventAsync("wa-show", nameof(TriggerShowAsync));
        }
    }

    [JSInvokable]
    public async Task NotifyValueChanged(DropdownSelectEventArgs eventArgs)
    {
        if (eventArgs.Checked is not null)
        {
            await CheckboxItemSelected.InvokeAsync(new(eventArgs.SelectedItem, eventArgs.Checked.Value));
        }
        else
        {
            await ValueChanged.InvokeAsync(eventArgs.SelectedItem);
        }
    }

    [JSInvokable]
    public async Task TriggerAfterHideAsync()
    {
        Open = false;
        await OpenChanged.InvokeAsync(Open);
        await OnAfterHide.InvokeAsync();
    }

    [JSInvokable]
    public async Task TriggerAfterShowAsync()
    {
        await OnAfterShow.InvokeAsync();
    }

    [JSInvokable]
    public async Task TriggerHideAsync()
    {
        await OnHide.InvokeAsync();
    }

    [JSInvokable]
    public async Task TriggerShowAsync()
    {
        Open = true;
        await OpenChanged.InvokeAsync(Open);
        await OnShow.InvokeAsync();
    }
}
