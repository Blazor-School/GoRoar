@namespace RoarUI
@inherits RoarJsComponentBase

<RoarDependency ComponentName="dropdown" />

<wa-dropdown distance="@Distance" open="@Open" placement="@Placement" size="@Size" skidding="@Skidding" @onroarselect="NotifyValueChanged" @onroarselect:preventDefault="KeepOpenOnSelect" @onroarafterhide="TriggerAfterHideAsync" @onroaraftershow="TriggerAfterShowAsync" @onroarhide="TriggerHideAsync" @onroarhide:preventDefault="KeepOpen" @onroarshow="TriggerShowAsync" @onroarshow:preventDefault="KeepClosed" @ref="Element" @attributes="AdditionalAttributes">
    @ChildContent
</wa-dropdown>

@code {
    /// <summary>
    /// The distance of the dropdown menu from its trigger.
    /// </summary>
    [Parameter]
    public double Distance { get; set; }

    /// <summary>
    /// Prevents the dropdown from closing when a hide event is raised.
    /// </summary>
    [Parameter]
    public bool KeepOpen { get; set; } = false;

    /// <summary>
    /// Prevents the dropdown from opening when a show event is raised.
    /// </summary>
    [Parameter]
    public bool KeepClosed { get; set; } = false;

    /// <summary>
    /// Keeps the menu open after selection and prevents navigation for link items. Selection callbacks still run.
    /// </summary>
    [Parameter]
    public bool KeepOpenOnSelect { get; set; } = false;

    /// <summary>
    /// Opens or closes the dropdown.
    /// </summary>
    [Parameter]
    public bool Open { get; set; } = false;

    /// <summary>
    /// Gets or sets a callback that updates the bound open.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Gets or sets an expression that identifies the bound open.
    /// </summary>
    [Parameter]
    public Expression<Func<bool>>? OpenExpression { get; set; }

    /// <summary>
    /// The placement of the dropdown menu in reference to the trigger. The menu will shift to a more optimal location if the preferred placement doesn't have enough room.
    /// </summary>
    [Parameter]
    public DropdownPlacement Placement { get; set; }

    /// <summary>
    /// The dropdown's size.
    /// </summary>
    [Parameter]
    public DropdownSize Size { get; set; }

    /// <summary>
    /// The offset of the dropdown menu along its trigger.
    /// </summary>
    [Parameter]
    public int Skidding { get; set; }

    /// <summary>
    /// Gets or sets the value of the input. This should be used with two-way binding.
    /// </summary>
    /// <example>
    /// @bind-Value="model.PropertyName"
    /// </example>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets a callback that updates the bound value.
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets an expression that identifies the bound value.
    /// </summary>
    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>
    /// Emitted when the dropdown is about to hide.
    /// </summary>
    [Parameter]
    public EventCallback OnHide { get; set; }

    /// <summary>
    /// Emitted after the dropdown has been hidden.
    /// </summary>
    [Parameter]
    public EventCallback OnAfterHide { get; set; }

    /// <summary>
    /// Emitted when the dropdown is about to show.
    /// </summary>
    [Parameter]
    public EventCallback OnShow { get; set; }

    /// <summary>
    /// Emitted after the dropdown has been shown.
    /// </summary>
    [Parameter]
    public EventCallback OnAfterShow { get; set; }

    /// <summary>
    /// The checkbox items with its state
    /// </summary>
    [Parameter]
    public EventCallback<KeyValuePair<string?, bool>> CheckboxItemSelected { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    public async Task NotifyValueChanged(RoarSelectEventArgs eventArgs)
    {
        if (eventArgs.Dropdown.Checked is not null)
        {
            await CheckboxItemSelected.InvokeAsync(new(eventArgs.Dropdown.SelectedItem, eventArgs.Dropdown.Checked.Value));
        }
        else
        {
            await ValueChanged.InvokeAsync(eventArgs.Dropdown.SelectedItem);
        }
    }

    public async Task TriggerAfterHideAsync()
    {
        await SyncComponentPropertyAsync(nameof(Open), "open", OpenChanged);
        await OnAfterHide.InvokeAsync();
    }

    public async Task TriggerAfterShowAsync()
    {
        await SyncComponentPropertyAsync(nameof(Open), "open", OpenChanged);
        await OnAfterShow.InvokeAsync();
    }

    public async Task TriggerHideAsync()
    {
        if (KeepOpen)
        {
            await SyncComponentPropertyAsync(nameof(Open), "open", OpenChanged);
        }

        await OnHide.InvokeAsync();
    }

    public async Task TriggerShowAsync()
    {
        if (KeepClosed)
        {
            await SyncComponentPropertyAsync(nameof(Open), "open", OpenChanged);
        }

        await OnShow.InvokeAsync();
    }
}
