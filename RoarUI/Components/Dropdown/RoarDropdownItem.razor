@namespace RoarUI
@inherits RoarJsEventComponentBase

<RoarDependency ComponentName="dropdown-item" />

<wa-dropdown-item type="normal" submenuOpen="@SubmenuOpen" disabled="@Disabled" variant="@Variant" value="@Value" @attributes="AdditionalAttributes" @ref="Element">
    @ChildContent
</wa-dropdown-item>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public bool SubmenuOpen { get; set; } = false;

    [Parameter]
    public DropdownItemVariant Variant { get; set; }

    /// <summary>
    /// Emitted when the dropdown item loses focus.
    /// </summary>
    [Parameter]
    public EventCallback OnBlur { get; set; }

    /// <summary>
    ///  Emitted when the dropdown item gains focus.
    /// </summary>
    [Parameter]
    public EventCallback OnFocus { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Closes the submenu.
    /// </summary>
    public ValueTask CloseSubmenuAsync() => CallComponentVoidFunctionAsync("closeSubmenu");

    /// <summary>
    /// Opens the submenu.
    /// </summary>
    public ValueTask OpenSubmenuAsync() => CallComponentVoidFunctionAsync("openSubmenu");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RegisterEventAsync("blur", nameof(TriggerBlurAsync));
            await RegisterEventAsync("focus", nameof(TriggerFocusAsync));
        }
    }

    [JSInvokable]
    public async Task TriggerBlurAsync()
    {
        await OnBlur.InvokeAsync();
    }

    [JSInvokable]
    public async Task TriggerFocusAsync()
    {
        await OnFocus.InvokeAsync();
    }
}
