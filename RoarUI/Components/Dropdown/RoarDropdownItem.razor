@namespace RoarUI
@inherits RoarJsComponentBase

<RoarDependency ComponentName="dropdown-item" />

<wa-dropdown-item type="normal" submenuOpen="@SubmenuOpen" disabled="@Disabled" variant="@Variant" value="@Value" @ref="Element" @attributes="InternalAttributes">
    @ChildContent
</wa-dropdown-item>

@code {
    private Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .MapEvent("onblur", "onroarblur")
            .MapEvent("onfocus", "onroarfocus")
            .Build();
    }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public bool SubmenuOpen { get; set; } = false;

    [Parameter]
    public DropdownItemVariant Variant { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Closes the submenu.
    /// </summary>
    public ValueTask CloseSubmenuAsync() => CallComponentVoidFunctionAsync("closeSubmenu");

    /// <summary>
    /// Opens the submenu.
    /// </summary>
    public ValueTask OpenSubmenuAsync() => CallComponentVoidFunctionAsync("openSubmenu");
}
