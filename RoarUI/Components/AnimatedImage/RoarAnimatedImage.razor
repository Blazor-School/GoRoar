@namespace RoarUI

<RoarDependency ComponentName="animated-image" />

<wa-animated-image src="@Src" alt="@Alt" play="@Play" @attributes="InternalAttributes">
    @ChildContent
</wa-animated-image>

@code {
    /// <summary>
    /// The size of the icon box. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? ControlBoxSize { get; set; }

    /// <summary>
    /// The size of the play/pause icons. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? IconSize { get; set; }

    /// <summary>
    /// The path to the image to load.
    /// </summary>
    [EditorRequired]
    [Parameter]
    public string Src { get; set; }

    /// <summary>
    /// A description of the image used by assistive devices.
    /// </summary>
    [Parameter]
    public string Alt { get; set; } = "";

    /// <summary>
    /// Plays the animation. When this attribute is remove, the animation will pause.
    /// </summary>
    [Parameter]
    public bool Play { get; set; } = false;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--control-box-size", ControlBoxSize)
            .AddStyle("--icon-size", IconSize)
            .Build();
    }
}
