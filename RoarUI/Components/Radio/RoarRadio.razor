@namespace RoarUI
@typeparam TValue

<RoarDependency ComponentName="radio" />

<wa-radio appearance="@Appearance" disabled="@Disabled" name="@GroupName" size="@Size" value="@Value?.ToString()" @attributes="InternalAttributes">
    @ChildContent
</wa-radio>

@code {
    /// <summary>
    /// The color of the checked icon. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? CheckedIconColor { get; set; }

    /// <summary>
    /// The size of the checked icon relative to the radio. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? CheckedIconScale { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The radio's visual appearance.
    /// </summary>
    [Parameter]
    public RadioAppearance Appearance { get; set; }

    /// <summary>
    /// Disables the radio.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    [CascadingParameter(Name = "RoarRadioGroupName")]
    public string GroupName { get; set; } = "";

    /// <summary>
    /// The radio's size. When omitted, the size is inherited. When used inside a radio group with an explicit size, the group's size will override this attribute.
    /// </summary>
    [Parameter]
    public InputSize? Size { get; set; }

    /// <summary>
    /// The radio's value. When selected, the radio group will receive this value.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--checked-icon-color", CheckedIconColor)
            .AddStyle("--checked-icon-scale", CheckedIconScale)
            .Build();
    }
}
