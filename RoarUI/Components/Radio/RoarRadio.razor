@namespace RoarUI
@typeparam TValue

<RoarDependency ComponentName="radio" />

<wa-radio appearance="@Appearance" disabled="@Disabled" name="@GroupName" size="@Size" value="@Value?.ToString()" @attributes="AdditionalAttributes">
    @ChildContent
</wa-radio>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The radio's visual appearance.
    /// </summary>
    [Parameter]
    public RadioAppearance Appearance { get; set; }

    /// <summary>
    /// Disables the radio.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    [CascadingParameter(Name = "RoarRadioGroupName")]
    public string GroupName { get; set; } = "";

    /// <summary>
    /// The radio's size. When omitted, the size is inherited. When used inside a radio group with an explicit size, the group's size will override this attribute.
    /// </summary>
    [Parameter]
    public InputSize? Size { get; set; }

    /// <summary>
    /// The radio's value. When selected, the radio group will receive this value.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }
}
