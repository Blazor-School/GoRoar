@namespace RoarUI

<RoarDependency ComponentName="qr-code" />

<wa-qr-code error-correction="@ErrorCorrection" image="@Image" image-coverage="@ImageCoverage.ToString(CultureInfo.InvariantCulture)" label="@Label" radius="@Radius" size="@Size" value="@Value" @attributes="InternalAttributes">
    @ChildContent
</wa-qr-code>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The color of the QR code's corners. Accepts any valid CSS color, including CSS custom properties via var().
    /// </summary>
    [Parameter]
    public string? CornerColor { get; set; }

    /// <summary>
    /// The level of error correction to use.
    /// </summary>
    [Parameter]
    public QRCodeErrorCorrection ErrorCorrection { get; set; }

    /// <summary>
    /// The URL of an image to display in the center of the QR code.
    /// </summary>
    [Parameter]
    public string? Image { get; set; }

    /// <summary>
    /// The amount of error correction coverage available to the image, from 0 to 1. Defaults to 0.5.
    /// </summary>
    [Parameter]
    public double ImageCoverage { get; set; } = 0.5;

    /// <summary>
    /// The label for assistive devices to announce. If unspecified, the value will be used instead.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>
    /// The edge radius of each module. Must be between 0 and 0.5.
    /// </summary>
    [Parameter]
    public double Radius { get; set; } = 0;

    /// <summary>
    /// The size of the QR code, in pixels.
    /// </summary>
    [Parameter]
    public int Size { get; set; } = 128;

    /// <summary>
    /// The QR code's value.
    /// </summary>
    [Parameter]
    public string Value { get; set; } = "";

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--corner-color", CornerColor)
            .Build();
    }
}
