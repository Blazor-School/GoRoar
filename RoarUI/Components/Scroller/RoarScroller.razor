@namespace RoarUI

<RoarDependency ComponentName="scroller" />

<wa-scroller orientation="@Orientation" without-scrollbar="@WithoutScrollbar" without-shadow="@WithoutShadow" @attributes="InternalAttributes">
    @ChildContent
</wa-scroller>

@code {
    /// <summary>
    /// The base color of the shadow. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? ShadowColor { get; set; }

    /// <summary>
    /// The size of the shadow. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? ShadowSize { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The scroller's orientation.
    /// </summary>
    [Parameter]
    public ScrollerOrientation Orientation { get; set; }

    /// <summary>
    /// Removes the visible scrollbar.
    /// </summary>
    [Parameter]
    public bool WithoutScrollbar { get; set; } = false;

    /// <summary>
    /// Removes the shadows.
    /// </summary>
    [Parameter]
    public bool WithoutShadow { get; set; } = false;

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--shadow-color", ShadowColor)
            .AddStyle("--shadow-size", ShadowSize)
            .Build();
    }
}
