@namespace RoarUI

<RoarDependency ComponentName="tab-group" />

<wa-tab-group activation="@Activation" active="@ActiveTabName" placement="@Placement" without-scroll-controls="@WithoutScrollControls" @onroartabhide="TriggerTabHide" @onroartabshow="TriggerTabShow" @attributes="InternalAttributes">
    @ChildContent
</wa-tab-group>

@code {
    /// <summary>
    /// The color of the active tab indicator. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? IndicatorColor { get; set; }

    /// <summary>
    /// The color of the indicator's track (the line that separates tabs from panels). Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? TrackColor { get; set; }

    /// <summary>
    /// The width of the indicator's track (the line that separates tabs from panels). Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? TrackWidth { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// When set to auto, navigating tabs with the arrow keys will instantly show the corresponding tab panel. When set to manual, the tab will receive focus but will not show until the user presses spacebar or enter.
    /// </summary>
    [Parameter]
    public TabGroupActivation Activation { get; set; }

    /// <summary>
    /// Sets the active tab.
    /// </summary>
    [Parameter]
    public string ActiveTabName { get; set; } = "";

    [Parameter]
    public EventCallback<string> ActiveTabNameChanged { get; set; }

    /// <summary>
    /// The placement of the tabs.
    /// </summary>
    [Parameter]
    public TabGroupPlacement Placement { get; set; }

    /// <summary>
    /// Disables the scroll arrows that appear when tabs overflow.
    /// </summary>
    [Parameter]
    public bool WithoutScrollControls { get; set; } = false;

    /// <summary>
    /// Emitted when a tab is hidden.
    /// </summary>
    [Parameter]
    public EventCallback<TabGroupHideEventArgs> OnTabHide { get; set; }

    /// <summary>
    /// Emitted when a tab is shown.
    /// </summary>
    [Parameter]
    public EventCallback<TabGroupShowEventArgs> OnTabShow { get; set; }

    public async Task TriggerTabHide(RoarTabHideEventArgs args)
    {
        ActiveTabName = args.TabGroup!.ActivatingTabName;
        await ActiveTabNameChanged.InvokeAsync(args.TabGroup.ActivatingTabName);
        await OnTabHide.InvokeAsync(args.TabGroup);
    }

    public async Task TriggerTabShow(RoarTabShowEventArgs args)
    {
        ActiveTabName = args.TabGroup!.TabName;
        await ActiveTabNameChanged.InvokeAsync(args.TabGroup.TabName);
        await OnTabShow.InvokeAsync(args.TabGroup);
    }

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--indicator-color", IndicatorColor)
            .AddStyle("--track-color", TrackColor)
            .AddStyle("--track-width", TrackWidth)
            .Build();
    }
}
