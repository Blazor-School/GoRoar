@namespace RoarUI

<RoarDependency ComponentName="tab-panel" />

<wa-tab-panel active="@Active" name="@Name" @attributes="InternalAttributes">
    @ChildContent
</wa-tab-panel>

@code {
    /// <summary>
    /// The tab panel's padding. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? Padding { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// When true, the tab panel will be shown.
    /// </summary>
    [Parameter]
    public bool Active { get; set; } = false;

    /// <summary>
    /// The tab panel's name.
    /// </summary>
    [Parameter]
    public string Name { get; set; } = "";

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--padding", Padding)
            .Build();
    }
}
