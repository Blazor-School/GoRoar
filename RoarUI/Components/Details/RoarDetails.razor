@namespace RoarUI
@inherits RoarJsComponentBase

<RoarDependency ComponentName="details" />

<wa-details appearance="@Appearance" disabled="@Disabled" icon-placement="@IconPlacement" name="@Name" open="@Open" summary="@Summary" @onroarafterhide="TriggerAfterHideAsync" @onroaraftershow="TriggerAfterShowAsync" @onroarhide="TriggerHideAsync" @onroarshow="TriggerShowAsync" @ref="Element" @attributes="AdditionalAttributes">
    @ChildContent
</wa-details>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The element's visual appearance.
    /// </summary>
    [Parameter]
    public DetailsAppearance Appearance { get; set; }

    /// <summary>
    /// Disables the details so it can't be toggled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// The location of the expand/collapse icon.
    /// </summary>
    [Parameter]
    public DetailsIconPlacement IconPlacement { get; set; }

    /// <summary>
    /// Groups related details elements. When one opens, others with the same name will close.
    /// </summary>
    [Parameter]
    public string Name { get; set; } = "";

    /// <summary>
    /// Indicates whether or not the details is open. You can toggle this attribute to show and hide the details.
    /// </summary>
    [Parameter]
    public bool Open { get; set; } = false;

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public Expression<Func<bool>>? OpenExpression { get; set; }

    /// <summary>
    /// The summary to show in the header. If you need to display HTML, use the summary slot instead.
    /// </summary>
    [Parameter]
    public string Summary { get; set; } = "";

    /// <summary>
    /// Emitted after the details closes and all animations are complete.
    /// </summary>
    [Parameter]
    public EventCallback OnAfterHide { get; set; }

    /// <summary>
    /// Emitted after the details opens and all animations are complete.
    /// </summary>
    [Parameter]
    public EventCallback OnAfterShow { get; set; }

    /// <summary>
    /// Emitted when the details closes.
    /// </summary>
    [Parameter]
    public EventCallback OnHide { get; set; }

    /// <summary>
    /// Emitted when the details opens.
    /// </summary>
    [Parameter]
    public EventCallback OnShow { get; set; }

    public ValueTask HideAsync() => CallComponentVoidFunctionAsync("hide");
    public ValueTask ShowAsync() => CallComponentVoidFunctionAsync("show");

    public async Task TriggerAfterHideAsync()
    {
        await OnAfterHide.InvokeAsync();
    }

    public async Task TriggerAfterShowAsync()
    {
        await OnAfterShow.InvokeAsync();
    }

    public async Task TriggerHideAsync()
    {
        await OpenChanged.InvokeAsync(false);
        await OnHide.InvokeAsync();
    }

    public async Task TriggerShowAsync()
    {
        await OpenChanged.InvokeAsync(true);
        await OnShow.InvokeAsync();
    }
}
