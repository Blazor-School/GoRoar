@namespace RoarUI

<RoarDependency ComponentName="avatar" />

<wa-avatar image="@ImageUrl" label="@Label" loading="@Loading" shape="@Shape" @attributes="InternalAttributes">@ChildContent</wa-avatar>

@code {
    /// <summary>
    /// The size of the avatar. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? Size { get; set; }

    /// <summary>
    /// The image source to use for the avatar.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public string ImageUrl { get; set; } = "";

    /// <summary>
    /// A label to use to describe the avatar to assistive devices.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>
    /// The shape of the avatar.
    /// </summary>
    [Parameter]
    public AvatarShape Shape { get; set; }

    /// <summary>
    /// Indicates how the browser should load the image.
    /// </summary>
    [Parameter]
    public AvatarLoading Loading { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--size", Size)
            .Build();
    }
}
