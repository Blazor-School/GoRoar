@namespace RoarUI

<RoarDependency ComponentName="roar-avatar-group" />

<roar-avatar-group @attributes="AdditionalAttributes">
    @ChildContent
</roar-avatar-group>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
