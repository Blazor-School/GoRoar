@namespace RoarUI
@typeparam TValue

<RoarDependency ComponentName="option" />

<wa-option value="@Convert.ToString(Value, CultureInfo.CurrentCulture)" label="@Label" disabled="@Disabled" @attributes="InternalAttributes">
    @ChildContent
</wa-option>

@code {
    /// <summary>
    /// The text color of the current (highlighted) option, paired with <c>--wa-form-control-activated-color</c>. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? CurrentTextColor { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The option's value. Values must be unique within a select and may not contain spaces.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>
    /// Disables the option.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// An optional plain text label for complex option content.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--current-text-color", CurrentTextColor)
            .Build();
    }
}
