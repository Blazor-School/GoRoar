@namespace RoarUI
@typeparam TValue

<RoarDependency ComponentName="option" />

<wa-option value="@Convert.ToString(Value, CultureInfo.CurrentCulture)" label="@Label" disabled="@Disabled" @attributes="AdditionalAttributes">
    @ChildContent
</wa-option>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The option's value. Values must be unique within a select and may not contain spaces.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>
    /// Disables the option.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// An optional plain text label for complex option content.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }
}
