@namespace RoarUI
@inherits RoarUI.Components.Input.RoarInputBase<bool?>

<RoarDependency ComponentName="checkbox" />

<wa-checkbox checked="@(CurrentValue == true)" indeterminate="@(CurrentValue is null)" disabled="@Disabled" hint="@Hint" size="@Size" @onroarchange="TriggerChangeAsync" @onroarinput="TriggerInputAsync" @ref="@Element" @attributes="InternalAttributes">
    @ChildContent
</wa-checkbox>

@code {
    /// <summary>
    /// The color of the checked and indeterminate icons. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? CheckedIconColor { get; set; }

    /// <summary>
    /// The size of the checked and indeterminate icons relative to the checkbox. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? CheckedIconScale { get; set; }

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Hint { get; set; } = "";

    [Parameter]
    public CheckboxSize Size { get; set; }

    [Parameter]
    public EventCallback OnChange { get; set; }

    [Parameter]
    public EventCallback OnInput { get; set; }

    public async Task TriggerChangeAsync(RoarChangeEventArgs args)
    {
        await SetCurrentValueAsync(ConvertStateFromEvent(args.Checkbox!));
        await OnChange.InvokeAsync();
    }

    public async Task TriggerInputAsync(RoarInputEventArgs args)
    {
        await SetCurrentValueAsync(ConvertStateFromEvent(args.Checkbox!));
        await OnInput.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        await SetComponentPropertyAsync("checked", CurrentValue == true);
        await SetComponentPropertyAsync("indeterminate", CurrentValue is null);
    }

    public ValueTask BlurAsync() => CallComponentVoidFunctionAsync("blur");
    public ValueTask ClickAsync() => CallComponentVoidFunctionAsync("click");
    public ValueTask FocusAsync(bool preventScroll = false, bool focusVisible = true) => CallComponentVoidFunctionAsync("focus", new { preventScroll, focusVisible });

    internal bool? ConvertStateFromEvent(CheckboxChangeEventArgs args)
    {
        if (args.Indeterminate)
        {
            return null;
        }
        else
        {
            return args.Checked;
        }
    }

    protected override bool TryParseValueFromString(string? value, out bool? result, [NotNullWhen(false)] out string? validationErrorMessage) => throw new NotSupportedException($"This component does not parse string inputs. Bind to the '{nameof(CurrentValue)}' property, not '{nameof(CurrentValueAsString)}'.");

    internal override AttributeBuilder InitializeAttributeBuilder() => base.InitializeAttributeBuilder()
        .AddStyle("--checked-icon-color", CheckedIconColor)
        .AddStyle("--checked-icon-scale", CheckedIconScale);
}
