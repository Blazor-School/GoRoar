@namespace RoarUI
@inject IJSRuntime JSRuntime
@inherits RoarUI.Components.Input.RoarInputBase<bool?>

<RoarDependency ComponentName="checkbox" />

<wa-checkbox checked="@(CurrentValue == true)" indeterminate="@(CurrentValue is null)" disabled="@Disabled" hint="@Hint" size="@Size" @attributes="InternalAttributes" @ref="@Element">
    @ChildContent
</wa-checkbox>

@code {
    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Hint { get; set; } = "";

    [Parameter]
    public CheckboxSize Size { get; set; }

    [Parameter]
    public EventCallback OnBlur { get; set; }

    [Parameter]
    public EventCallback OnChange { get; set; }

    [Parameter]
    public EventCallback OnFocus { get; set; }

    [Parameter]
    public EventCallback OnInput { get; set; }

    [Parameter]
    public EventCallback OnInvalid { get; set; }

    internal ElementReference Element { get; set; }

    [JSInvokable]
    public Task TriggerBlurAsync() => OnBlur.InvokeAsync();

    [JSInvokable]
    public async Task TriggerChangeAsync(CheckboxChangeEventArgs args)
    {
        await OnChange.InvokeAsync();
        await SetCurrentValueAsync(ConvertStateFromEvent(args));
    }

    [JSInvokable]
    public Task TriggerFocusAsync() => OnFocus.InvokeAsync();

    [JSInvokable]
    public async Task TriggerInputAsync(CheckboxChangeEventArgs args)
    {
        await OnInput.InvokeAsync();
        await SetCurrentValueAsync(ConvertStateFromEvent(args));
    }

    [JSInvokable]
    public Task TriggerInvalidAsync() => OnInvalid.InvokeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var instance = DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEvent, Element, "blur", instance, nameof(TriggerBlurAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEventWithArgs, Element, "change", nameof(CheckboxChangeEventArgs), instance, nameof(TriggerChangeAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEvent, Element, "focus", instance, nameof(TriggerFocusAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEventWithArgs, Element, "input", nameof(CheckboxChangeEventArgs), instance, nameof(TriggerInputAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEvent, Element, "wa-invalid", instance, nameof(TriggerInvalidAsync));
        }
    }

    public ValueTask BlurAsync() => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "blur");
    public ValueTask ClickAsync() => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "click");
    public ValueTask FocusAsync(bool preventScroll = false, bool focusVisible = true) => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "focus", new { preventScroll, focusVisible });
    internal ValueTask ResetValidityAsync() => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "resetValidity");
    internal ValueTask SetCustomValidityAsync(string message) => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "setCustomValidity", new { message });

    internal bool? ConvertStateFromEvent(CheckboxChangeEventArgs args)
    {
        if (args.Indeterminate)
        {
            return null;
        }
        else
        {
            return args.Checked;
        }
    }

    protected override bool TryParseValueFromString(string? value, out bool? result, [NotNullWhen(false)] out string? validationErrorMessage) => throw new NotSupportedException($"This component does not parse string inputs. Bind to the '{nameof(CurrentValue)}' property, not '{nameof(CurrentValueAsString)}'.");
}
