@namespace RoarUI
@inherits RoarUI.Components.Input.RoarInputBase<bool>

<RoarDependency ComponentName="checkbox" />

<wa-checkbox checked="@CurrentValue" disabled="@Disabled" hint="@Hint" size="@Size" @attributes="InternalAttributes" @ref="@Element">
    @ChildContent
</wa-checkbox>

@code {
    /// <summary>
    /// Disables the checkbox.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// The checkbox's hint. If you need to display HTML, use the hint slot instead.
    /// </summary>
    [Parameter]
    public string Hint { get; set; } = "";

    /// <summary>
    /// The checkbox's size.
    /// </summary>
    [Parameter]
    public CheckboxSize Size { get; set; }

    /// <summary>
    /// Emitted when the checkbox loses focus.
    /// </summary>
    [Parameter]
    public EventCallback OnBlur { get; set; }

    /// <summary>
    /// Emitted when the checked state changes.
    /// </summary>
    [Parameter]
    public EventCallback OnChange { get; set; }

    /// <summary>
    /// Emitted when the checkbox gains focus.
    /// </summary>
    [Parameter]
    public EventCallback OnFocus { get; set; }

    /// <summary>
    /// Emitted when the checkbox receives input.
    /// </summary>
    [Parameter]
    public EventCallback OnInput { get; set; }

    [JSInvokable]
    public Task TriggerBlurAsync() => OnBlur.InvokeAsync();

    [JSInvokable]
    public async Task TriggerChangeAsync(CheckboxChangeEventArgs args)
    {
        await SetCurrentValueAsync(args.Checked);
        await OnChange.InvokeAsync();
    }

    [JSInvokable]
    public Task TriggerFocusAsync() => OnFocus.InvokeAsync();

    [JSInvokable]
    public async Task TriggerInputAsync(CheckboxChangeEventArgs args)
    {
        await SetCurrentValueAsync(args.Checked);
        await OnInput.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RegisterEventAsync("blur", nameof(TriggerBlurAsync));
            await RegisterEventAsync("change", nameof(CheckboxChangeEventArgs), nameof(TriggerChangeAsync));
            await RegisterEventAsync("focus", nameof(TriggerFocusAsync));
            await RegisterEventAsync("input", nameof(CheckboxChangeEventArgs), nameof(TriggerInputAsync));
        }
    }

    /// <summary>
    /// Removes focus from the checkbox.
    /// </summary>
    /// <returns></returns>
    public ValueTask BlurAsync() => CallComponentFunctionAsync("blur");

    /// <summary>
    /// Simulates a click on the checkbox.
    /// </summary>
    /// <returns></returns>
    public ValueTask ClickAsync() => CallComponentFunctionAsync("click");

    /// <summary>
    /// Sets focus on the checkbox.
    /// </summary>
    /// <param name="preventScroll"></param>
    /// <param name="focusVisible"></param>
    /// <returns></returns>
    public ValueTask FocusAsync(bool preventScroll = false, bool focusVisible = true) => CallComponentFunctionAsync("focus", new { preventScroll, focusVisible });

    protected override bool TryParseValueFromString(string? value, out bool result, [NotNullWhen(false)] out string? validationErrorMessage) => throw new NotSupportedException($"This component does not parse string inputs. Bind to the '{nameof(CurrentValue)}' property, not '{nameof(CurrentValueAsString)}'.");
}
