@namespace RoarUI
@inject IJSRuntime JSRuntime

<RoarDependency ComponentName="checkbox" />

<wa-checkbox checked="@Checked" default-checked="@DefaultChecked" disabled="@Disabled" hint="@Hint" indeterminate="@Indeterminate" name="@Name" required="@Required" size="@Size" value="@Value" @attributes="AdditionalAttributes" @ref="@Element">
    @ChildContent
</wa-checkbox>

@code {
    [CascadingParameter]
    public EditContext? Context { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public bool Checked { get; set; } = false;

    [Parameter]
    public bool DefaultChecked { get; set; } = false;

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Hint { get; set; } = "";

    [Parameter]
    public bool Indeterminate { get; set; } = false;

    [Parameter]
    public string Name { get; set; } = "";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public CheckboxSize Size { get; set; }

    [Parameter]
    public string Value { get; set; } = "";

    internal ElementReference Element { get; set; }

    [Parameter]
    public EventCallback OnBlur { get; set; }

    [Parameter]
    public EventCallback OnChange { get; set; }

    [Parameter]
    public EventCallback OnFocus { get; set; }

    [Parameter]
    public EventCallback OnInput { get; set; }

    [Parameter]
    public EventCallback OnInvalid { get; set; }

    [JSInvokable]
    public Task TriggerBlurAsync() => OnBlur.InvokeAsync();

    [JSInvokable]
    public Task TriggerChangeAsync() => OnChange.InvokeAsync();

    [JSInvokable]
    public Task TriggerFocusAsync() => OnFocus.InvokeAsync();

    [JSInvokable]
    public Task TriggerInputAsync() => OnInput.InvokeAsync();

    [JSInvokable]
    public Task TriggerInvalidAsync() => OnInvalid.InvokeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var instance = DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEvent, Element, "blur", instance, nameof(TriggerBlurAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEvent, Element, "change", instance, nameof(TriggerChangeAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEvent, Element, "focus", instance, nameof(TriggerFocusAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEvent, Element, "input", instance, nameof(TriggerInputAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEvent, Element, "wa-invalid", instance, nameof(TriggerInvalidAsync));
        }
    }

    public ValueTask BlurAsync() => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "blur");
    public ValueTask ClickAsync() => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "click");
    public ValueTask FocusAsync(bool preventScroll = false, bool focusVisible = true) => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "focus", new { preventScroll, focusVisible });
    public ValueTask ResetValidityAsync() => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "resetValidity");
    public ValueTask SetCustomValidityAsync(string message) => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "setCustomValidity", new { message });
}
