@namespace RoarUI
@inject IJSRuntime JSRuntime

<RoarDependency ComponentName="checkbox-group" />

<wa-checkbox-group hint="@Hint" label="@Label" orientation="@Orientation" @attributes="AdditionalAttributes">
    @ChildContent
</wa-checkbox-group>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The checkbox group's hint. If you need to display HTML, use the hint slot instead.
    /// </summary>
    [Parameter]
    public string Hint { get; set; } = "";

    /// <summary>
    /// The checkbox group's label. Required for proper accessibility. If you need to display HTML, use the label slot instead.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>
    /// The orientation in which to show grouped checkboxes.
    /// </summary>
    [Parameter]
    public CheckboxGroupOrientation Orientation { get; set; }
}
