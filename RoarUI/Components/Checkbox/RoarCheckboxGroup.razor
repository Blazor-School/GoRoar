@namespace RoarUI
@inject IJSRuntime JSRuntime

<RoarDependency ComponentName="checkbox-group" />

<CascadingValue Value="this">
    <wa-checkbox-group hint="@Hint" label="@Label" orientation="@Orientation" with-hint="@WithHint" with-label="@WithLabel" @attributes="AdditionalAttributes">
        @ChildContent
    </wa-checkbox-group>
</CascadingValue>

@code {
    [CascadingParameter]
    private EditContext? EditContext { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Identifies the form field represented by the checkbox group.
    /// </summary>
    [Parameter]
    public Expression<Func<object>>? For { get; set; }

    /// <summary>
    /// The checkbox group's hint. If you need to display HTML, use the hint slot instead.
    /// </summary>
    [Parameter]
    public string Hint { get; set; } = "";

    /// <summary>
    /// The checkbox group's label. Required for proper accessibility. If you need to display HTML, use the label slot instead.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>
    /// The orientation in which to show grouped checkboxes.
    /// </summary>
    [Parameter]
    public CheckboxGroupOrientation Orientation { get; set; }

    /// <summary>
    /// Only required for SSR.
    /// </summary>
    [Parameter]
    public bool WithHint { get; set; } = false;

    /// <summary>
    /// Only required for SSR.
    /// </summary>
    [Parameter]
    public bool WithLabel { get; set; } = false;

    internal void NotifyGroupChanged()
    {
        if (EditContext is not null && For is not null)
        {
            EditContext.NotifyFieldChanged(FieldIdentifier.Create(For));
        }
    }
}
