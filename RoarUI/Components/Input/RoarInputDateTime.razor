@namespace RoarUI
@inject IJSRuntime JSRuntime
@inherits RoarUI.Components.Input.RoarInputBase<TValue>
@typeparam TValue

<RoarDependency ComponentName="input" />

<wa-input appearance="@Appearance" autocomplete="@Autocomplete" autofocus="@Autofocus" value="@CurrentValueAsString" disabled="@Disabled" enterkeyhint="@EnterKeyHint" hint="@Hint" inputmode="text" label="@Label" name="@NameAttributeValue" pill="@Pill" readonly="@ReadOnly" size="@Size" type="datetime-local" with-clear="@WithClear" with-hint="@WithHint" with-label="@WithLabel" @attributes="InternalAttributes" @ref="Element">
    @ChildContent
</wa-input>

@code {
    /// <summary>
    /// The input's visual appearance.
    /// </summary>
    [Parameter]
    public InputAppearance Appearance { get; set; }

    /// <summary>
    /// Specifies what permission the browser has to provide assistance in filling out form field values. Refer to this page on MDN for available values.
    /// </summary>
    [Parameter]
    public string Autocomplete { get; set; } = "off";

    /// <summary>
    /// Indicates that the input should receive focus on page load.
    /// </summary>
    [Parameter]
    public bool Autofocus { get; set; } = false;

    /// <summary>
    /// Disables the form control.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// Used to customize the label or icon of the Enter key on virtual keyboards.
    /// </summary>
    [Parameter]
    public InputEnterKeyHint? EnterKeyHint { get; set; }

    /// <summary>
    /// The input's hint. If you need to display HTML, use the hint slot instead.
    /// </summary>
    [Parameter]
    public string Hint { get; set; } = "";

    /// <summary>
    /// The input's label. If you need to display HTML, use the label slot instead.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>
    /// Draws a pill-style input with rounded edges.
    /// </summary>
    [Parameter]
    public bool Pill { get; set; } = false;

    /// <summary>
    /// Makes the input readonly.
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; } = false;

    /// <summary>
    /// The input's size.
    /// </summary>
    [Parameter]
    public InputSize Size { get; set; }

    /// <summary>
    /// Adds a clear button when the input is not empty.
    /// </summary>
    [Parameter]
    public bool WithClear { get; set; } = false;

    /// <summary>
    /// Only required for SSR. Set to true if you're slotting in a hint element so the server-rendered markup includes the hint before the component hydrates on the client.
    /// </summary>
    [Parameter]
    public bool WithHint { get; set; } = false;

    /// <summary>
    /// Only required for SSR. Set to true if you're slotting in a label element so the server-rendered markup includes the label before the component hydrates on the client.
    /// </summary>
    [Parameter]
    public bool WithLabel { get; set; } = false;

    /// <summary>
    /// Gets or sets the error message used when displaying an a parsing error.
    /// </summary>
    [Parameter]
    public string ParsingErrorMessage { get; set; } = string.Empty;

    /// <summary>
    /// Emitted when the control loses focus.
    /// </summary>
    [Parameter]
    public EventCallback OnBlur { get; set; }

    /// <summary>
    /// Emitted when an alteration to the control's value is committed by the user.
    /// </summary>
    [Parameter]
    public EventCallback OnChange { get; set; }

    /// <summary>
    /// Emitted when the control gains focus.
    /// </summary>
    [Parameter]
    public EventCallback OnFocus { get; set; }

    /// <summary>
    /// Emitted when the control receives input.
    /// </summary>
    [Parameter]
    public EventCallback OnInput { get; set; }

    /// <summary>
    /// Emitted when the clear button is activated.
    /// </summary>
    [Parameter]
    public EventCallback OnClear { get; set; }

    [JSInvokable]
    public Task TriggerBlurAsync() => OnBlur.InvokeAsync();

    [JSInvokable]
    public async Task TriggerChangeAsync(InputChangeEventArgs<string?> args)
    {
        await OnChange.InvokeAsync();
        await SetCurrentValueAsStringAsync(args.Value);
    }

    [JSInvokable]
    public Task TriggerFocusAsync() => OnFocus.InvokeAsync();

    [JSInvokable]
    public async Task TriggerInputAsync(InputChangeEventArgs<string?> args)
    {
        await OnInput.InvokeAsync();
        await SetCurrentValueAsStringAsync(args.Value);
    }

    [JSInvokable]
    public Task TriggerClearAsync() => OnClear.InvokeAsync();

    /// <summary>
    /// Removes focus from the input.
    /// </summary>
    public ValueTask BlurAsync() => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "blur");

    /// <summary>
    /// Sets focus on the input.
    /// </summary>
    /// <param name="preventScroll"></param>
    /// <param name="focusVisible"></param>
    public ValueTask FocusAsync(bool preventScroll = false, bool focusVisible = true) => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "focus", new { preventScroll, focusVisible });

    /// <summary>
    /// Selects all the text in the input.
    /// </summary>
    public ValueTask SelectAsync() => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "select");

    /// <summary>
    /// Replaces a range of text with a new string.
    /// </summary>
    /// <param name="replacement"></param>
    /// <param name="start"></param>
    /// <param name="end"></param>
    /// <param name="selectMode"></param>
    public ValueTask SetRangeTextAsync(string replacement, int start, int end, InputTextSelectMode selectMode) => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "setRangeText", replacement, start, end, selectMode.ToString());

    /// <summary>
    /// Sets the start and end positions of the text selection (0-based).
    /// </summary>
    /// <param name="selectionStart"></param>
    /// <param name="selectionEnd"></param>
    /// <param name="selectionDirection"></param>
    public ValueTask SetSelectionRangeAsync(int selectionStart, int selectionEnd, InputTextSelectionDirection selectionDirection) => JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.ExecuteJsFunctionFromJsObject, Element, "setSelectionRange", selectionStart, selectionEnd, selectionDirection);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var instance = DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEvent, Element, "blur", instance, nameof(TriggerBlurAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEventWithArgs, Element, "change", nameof(InputChangeEventArgs<>), instance, nameof(TriggerChangeAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEvent, Element, "focus", instance, nameof(TriggerFocusAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEventWithArgs, Element, "input", nameof(InputChangeEventArgs<>), instance, nameof(TriggerInputAsync));
            await JSRuntime.InvokeVoidAsync(JavascriptFunctionNames.SubscribeEvent, Element, "wa-clear", instance, nameof(TriggerClearAsync));
        }
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (BindConverter.TryConvertTo(value, CultureInfo.InvariantCulture, out result))
        {
            Debug.Assert(result != null);
            validationErrorMessage = null;

            return true;
        }
        else
        {
            string _parsingErrorMessage = string.IsNullOrEmpty(ParsingErrorMessage) ? $"The {{0}} field must be a date with format yyyy-MM-ddTHH:mm:ss." : ParsingErrorMessage;
            validationErrorMessage = string.Format(CultureInfo.InvariantCulture, _parsingErrorMessage, NameAttributeValue);

            return false;
        }
    }

    protected override string FormatValueAsString(TValue? value) => value switch
    {
        DateTime dateTime => BindConverter.FormatValue(dateTime, "yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture),
        _ => string.Empty
    };
}
