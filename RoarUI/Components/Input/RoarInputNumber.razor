@namespace RoarUI
@inherits RoarUI.Components.Input.RoarInputBase<TValue>
@typeparam TValue

<RoarDependency ComponentName="number-input" />

<wa-number-input appearance="@Appearance" autocomplete="@Autocomplete" autofocus="@Autofocus" value="@CurrentValueAsString" disabled="@Disabled" enterkeyhint="@EnterKeyHint" hint="@Hint" inputmode="text" label="@Label" pill="@Pill" placeholder="@Placeholder" readonly="@ReadOnly" size="@Size" type="number" with-hint="@WithHint" with-label="@WithLabel" without-steppers="@WithoutSteppers" @attributes="InternalAttributes" @ref="Element">
    @ChildContent
</wa-number-input>

@code {
    /// <summary>
    /// The input's visual appearance.
    /// </summary>
    [Parameter]
    public InputAppearance Appearance { get; set; }

    /// <summary>
    /// Specifies what permission the browser has to provide assistance in filling out form field values. Refer to this page on MDN for available values.
    /// </summary>
    [Parameter]
    public string Autocomplete { get; set; } = "off";

    /// <summary>
    /// Indicates that the input should receive focus on page load.
    /// </summary>
    [Parameter]
    public bool Autofocus { get; set; } = false;

    /// <summary>
    /// Disables the form control.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// Used to customize the label or icon of the Enter key on virtual keyboards.
    /// </summary>
    [Parameter]
    public InputEnterKeyHint? EnterKeyHint { get; set; }

    /// <summary>
    /// The input's hint. If you need to display HTML, use the hint slot instead.
    /// </summary>
    [Parameter]
    public string Hint { get; set; } = "";

    /// <summary>
    /// The input's label. If you need to display HTML, use the label slot instead.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>
    /// Draws a pill-style input with rounded edges.
    /// </summary>
    [Parameter]
    public bool Pill { get; set; } = false;

    /// <summary>
    /// Placeholder text to show as a hint when the input is empty.
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = "";

    /// <summary>
    /// Makes the input readonly.
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; } = false;

    /// <summary>
    /// The input's size.
    /// </summary>
    [Parameter]
    public InputSize Size { get; set; }

    /// <summary>
    /// Only required for SSR.
    /// </summary>
    [Parameter]
    public bool WithHint { get; set; } = false;

    /// <summary>
    /// Only required for SSR.
    /// </summary>
    [Parameter]
    public bool WithLabel { get; set; } = false;

    /// <summary>
    /// Hides the increment/decrement stepper buttons.
    /// </summary>
    [Parameter]
    public bool WithoutSteppers { get; set; } = false;

    /// <summary>
    /// Gets or sets the error message used when displaying an a parsing error.
    /// </summary>
    [Parameter]
    public string ParsingErrorMessage { get; set; } = "The {0} field must be a number.";

    /// <summary>
    /// Emitted when the control loses focus.
    /// </summary>
    [Parameter]
    public EventCallback OnBlur { get; set; }

    /// <summary>
    /// Emitted when an alteration to the control's value is committed by the user.
    /// </summary>
    [Parameter]
    public EventCallback OnChange { get; set; }

    /// <summary>
    /// Emitted when the control gains focus.
    /// </summary>
    [Parameter]
    public EventCallback OnFocus { get; set; }

    /// <summary>
    /// Emitted when the control receives input.
    /// </summary>
    [Parameter]
    public EventCallback OnInput { get; set; }

    /// <summary>
    /// Emitted before the value changes. Can be cancelled with event.preventDefault() to prevent the value from changing.
    /// </summary>
    [Parameter]
    public EventCallback OnBeforeInput { get; set; }

    /// <summary>
    /// Emitted before the value changes. When true, the value will not be changed.
    /// </summary>
    [Parameter]
    public bool OnBeforeInputPreventDefault { get; set; }

    /// <summary>
    /// Stop propagation of the before input event.
    /// </summary>
    [Parameter]
    public bool OnBeforeInputStopPropagation { get; set; }

    [JSInvokable]
    public Task TriggerBlurAsync() => OnBlur.InvokeAsync();

    [JSInvokable]
    public async Task TriggerChangeAsync(InputChangeEventArgs<string?> args) // We receive value as a string from JS side
    {
        await SetCurrentValueAsStringAsync(args.Value);
        await OnChange.InvokeAsync();
    }

    [JSInvokable]
    public Task TriggerFocusAsync() => OnFocus.InvokeAsync();

    [JSInvokable]
    public async Task TriggerInputAsync(InputChangeEventArgs<string?> args) // We receive value as a string from JS side
    {
        await SetCurrentValueAsStringAsync(args.Value);
        await OnInput.InvokeAsync();
    }

    [JSInvokable]
    public Task TriggerBeforeInputAsync() => OnBeforeInput.InvokeAsync();

    /// <summary>
    /// Removes focus from the input.
    /// </summary>
    public ValueTask BlurAsync() => CallComponentVoidFunctionAsync("blur");

    /// <summary>
    /// Selects all the text in the input.
    /// </summary>
    public ValueTask SelectAsync() => CallComponentVoidFunctionAsync("select");

    /// <summary>
    /// Sets focus on the input.
    /// </summary>
    /// <param name="preventScroll"></param>
    /// <param name="focusVisible"></param>
    public ValueTask FocusAsync(bool preventScroll = false, bool focusVisible = true) => CallComponentVoidFunctionAsync("focus", new { preventScroll, focusVisible });

    /// <summary>
    /// Decrements the value of a numeric input type by the value of the step attribute.
    /// </summary>
    public async ValueTask StepDownAsync()
    {
        await CallComponentVoidFunctionAsync("stepDown");
        await SyncComponentValue();
    }

    /// <summary>
    /// Increments the value of a numeric input type by the value of the step attribute.
    /// </summary>
    public async ValueTask StepUpAsync()
    {
        await CallComponentVoidFunctionAsync("stepUp");
        await SyncComponentValue();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RegisterEventAsync("blur", nameof(TriggerBlurAsync));
            await RegisterEventAsync("change", nameof(InputChangeEventArgs<>), nameof(TriggerChangeAsync));
            await RegisterEventAsync("focus", nameof(TriggerFocusAsync));
            await RegisterEventAsync("input", nameof(InputChangeEventArgs<>), nameof(TriggerInputAsync));
            await RegisterEventAsync("beforeinput", nameof(TriggerBeforeInputAsync));
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (string.IsNullOrEmpty(value))
        {
            result = default!;
            validationErrorMessage = null;

            return true;
        }

        if (BindConverter.TryConvertTo(value, CultureInfo.InvariantCulture, out result))
        {
            Debug.Assert(result != null);
            validationErrorMessage = null;

            return true;
        }
        else
        {
            validationErrorMessage = string.Format(CultureInfo.InvariantCulture, ParsingErrorMessage, NameAttributeValue);

            return false;
        }
    }

    internal override AttributeBuilder InitializeAttributeBuilder() => base.InitializeAttributeBuilder()
            .AddEventModifier("beforeinput", EventModifier.PreventDefault, OnBeforeInputPreventDefault)
            .AddEventModifier("beforeinput", EventModifier.StopPropagation, OnBeforeInputStopPropagation);

    protected override string? FormatValueAsString(TValue? value) => value switch
    {
        null => null,
        int @int => BindConverter.FormatValue(@int, CultureInfo.InvariantCulture),
        long @long => BindConverter.FormatValue(@long, CultureInfo.InvariantCulture),
        short @short => BindConverter.FormatValue(@short, CultureInfo.InvariantCulture),
        float @float => BindConverter.FormatValue(@float, CultureInfo.InvariantCulture),
        double @double => BindConverter.FormatValue(@double, CultureInfo.InvariantCulture),
        decimal @decimal => BindConverter.FormatValue(@decimal, CultureInfo.InvariantCulture),
        _ => throw new InvalidOperationException($"Unsupported type {value.GetType()}")
    };
}
