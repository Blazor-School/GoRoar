@namespace RoarUI
@inherits RoarUI.Components.Input.RoarInputBase<string?>

<RoarDependency ComponentName="input" />

<wa-input appearance="@Appearance" autocapitalize="@Autocapitalize" autofocus="@Autofocus" value="@CurrentValueAsString" disabled="@Disabled" enterkeyhint="@EnterKeyHint" hint="@Hint" inputmode="text" label="@Label" pill="@Pill" placeholder="@Placeholder" readonly="@ReadOnly" size="@Size" spellcheck="@Spellcheck" type="password" password-toggle="@PasswordToggle" password-visible="@PasswordVisible" with-clear="@WithClear" with-hint="@WithHint" with-label="@WithLabel" @attributes="InternalAttributes" @ref="Element">
    @ChildContent
</wa-input>

@code {
    /// <summary>
    /// The input's visual appearance.
    /// </summary>
    [Parameter]
    public InputAppearance Appearance { get; set; }

    /// <summary>
    /// Controls whether and how text input is automatically capitalized as it is entered by the user.
    /// </summary>
    [Parameter]
    public InputAutocapitalize? Autocapitalize { get; set; }

    /// <summary>
    /// Indicates that the input should receive focus on page load.
    /// </summary>
    [Parameter]
    public bool Autofocus { get; set; } = false;

    /// <summary>
    /// Disables the form control.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// Used to customize the label or icon of the Enter key on virtual keyboards.
    /// </summary>
    [Parameter]
    public InputEnterKeyHint? EnterKeyHint { get; set; }

    /// <summary>
    /// The input's hint. If you need to display HTML, use the hint slot instead.
    /// </summary>
    [Parameter]
    public string Hint { get; set; } = "";

    /// <summary>
    /// The input's label. If you need to display HTML, use the label slot instead.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>
    /// Adds a button to toggle the password's visibility. Only applies to password types.
    /// </summary>
    [Parameter]
    public bool PasswordToggle { get; set; } = false;

    /// <summary>
    /// Determines whether or not the password is currently visible. Only applies to password input types.
    /// </summary>
    [Parameter]
    public bool PasswordVisible { get; set; } = false;

    /// <summary>
    /// Draws a pill-style input with rounded edges.
    /// </summary>
    [Parameter]
    public bool Pill { get; set; } = false;

    /// <summary>
    /// Placeholder text to show as a hint when the input is empty.
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = "";

    /// <summary>
    /// Makes the input readonly.
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; } = false;

    /// <summary>
    /// The input's size.
    /// </summary>
    [Parameter]
    public InputSize Size { get; set; }

    /// <summary>
    /// Enables spell checking on the input.
    /// </summary>
    [Parameter]
    public bool Spellcheck { get; set; } = true;

    /// <summary>
    /// Adds a clear button when the input is not empty.
    /// </summary>
    [Parameter]
    public bool WithClear { get; set; } = false;

    /// <summary>
    /// Only required for SSR. Set to true if you're slotting in a hint element so the server-rendered markup includes the hint before the component hydrates on the client.
    /// </summary>
    [Parameter]
    public bool WithHint { get; set; } = false;

    /// <summary>
    /// Only required for SSR. Set to true if you're slotting in a label element so the server-rendered markup includes the label before the component hydrates on the client.
    /// </summary>
    [Parameter]
    public bool WithLabel { get; set; } = false;

    /// <summary>
    /// Emitted when the control loses focus.
    /// </summary>
    [Parameter]
    public EventCallback OnBlur { get; set; }

    /// <summary>
    /// Emitted when an alteration to the control's value is committed by the user.
    /// </summary>
    [Parameter]
    public EventCallback OnChange { get; set; }

    /// <summary>
    /// Emitted when the control gains focus.
    /// </summary>
    [Parameter]
    public EventCallback OnFocus { get; set; }

    /// <summary>
    /// Emitted when the control receives input.
    /// </summary>
    [Parameter]
    public EventCallback OnInput { get; set; }

    /// <summary>
    /// Emitted when the clear button is activated.
    /// </summary>
    [Parameter]
    public EventCallback OnClear { get; set; }

    [JSInvokable]
    public Task TriggerBlurAsync() => OnBlur.InvokeAsync();

    [JSInvokable]
    public async Task TriggerChangeAsync(InputChangeEventArgs<string> args)
    {
        await SetCurrentValueAsync(args.Value);
        await OnChange.InvokeAsync();
    }

    [JSInvokable]
    public Task TriggerFocusAsync() => OnFocus.InvokeAsync();

    [JSInvokable]
    public async Task TriggerInputAsync(InputChangeEventArgs<string> args)
    {
        await SetCurrentValueAsync(args.Value);
        await OnInput.InvokeAsync();
    }

    [JSInvokable]
    public Task TriggerClearAsync() => OnClear.InvokeAsync();

    /// <summary>
    /// Removes focus from the input.
    /// </summary>
    public ValueTask BlurAsync() => CallComponentVoidFunctionAsync("blur");

    /// <summary>
    /// Sets focus on the input.
    /// </summary>
    /// <param name="preventScroll"></param>
    /// <param name="focusVisible"></param>
    public ValueTask FocusAsync(bool preventScroll = false, bool focusVisible = true) => CallComponentVoidFunctionAsync("focus", new { preventScroll, focusVisible });

    /// <summary>
    /// Selects all the text in the input.
    /// </summary>
    public ValueTask SelectAsync() => CallComponentVoidFunctionAsync("select");

    /// <summary>
    /// Replaces a range of text with a new string.
    /// </summary>
    /// <param name="replacement"></param>
    /// <param name="start"></param>
    /// <param name="end"></param>
    /// <param name="selectMode"></param>
    public async ValueTask SetRangeTextAsync(string replacement, int start, int end, InputTextSelectMode selectMode)
    {
        await CallComponentVoidFunctionAsync("setRangeText", replacement, start, end, selectMode.ToString());
        await SyncComponentValue();
    }

    /// <summary>
    /// Sets the start and end positions of the text selection (0-based).
    /// </summary>
    /// <param name="selectionStart"></param>
    /// <param name="selectionEnd"></param>
    /// <param name="selectionDirection"></param>
    public ValueTask SetSelectionRangeAsync(int selectionStart, int selectionEnd, InputTextSelectionDirection selectionDirection) => CallComponentVoidFunctionAsync("setSelectionRange", selectionStart, selectionEnd, selectionDirection.ToString());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RegisterEventAsync("blur", nameof(TriggerBlurAsync));
            await RegisterEventAsync("change", nameof(InputChangeEventArgs<>), nameof(TriggerChangeAsync));
            await RegisterEventAsync("focus", nameof(TriggerFocusAsync));
            await RegisterEventAsync("input", nameof(InputChangeEventArgs<>), nameof(TriggerInputAsync));
            await RegisterEventAsync("wa-clear", nameof(TriggerClearAsync));
        }
    }

    protected override bool TryParseValueFromString(string? value, out string? result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;

        return true;
    }
}
