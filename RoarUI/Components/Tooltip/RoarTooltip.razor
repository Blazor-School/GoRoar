@namespace RoarUI
@inherits RoarJsComponentBase

<RoarDependency ComponentName="tooltip" />

<wa-tooltip for="@For" placement="@Placement" trigger="@JoinTriggers" distance="@Distance" disabled="@Disabled" hide-delay="@HideDelay" show-delay="@ShowDelay" skidding="@Skidding" @onroarafterhide="TriggerAfterHideAsync" @onroaraftershow="TriggerAfterShowAsync" @onroarhide="TriggerHideAsync" @onroarshow="TriggerShowAsync" @ref="Element" without-arrow="@NoArrow" @attributes="InternalAttributes">
    @ChildContent
</wa-tooltip>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The id of the host element that the tooltip is attached to. This is required for the tooltip to function.
    /// </summary>
    [EditorRequired]
    [Parameter]
    public string For { get; set; }

    /// <summary>
    /// The preferred placement of the tooltip. Note that the actual placement may vary as needed to keep the tooltip inside of the viewport.
    /// </summary>
    [Parameter]
    public TooltipPlacement Placement { get; set; }

    /// <summary>
    /// Controls how the tooltip is activated. Possible options include <see cref="TooltipTrigger.Click" />, <see cref="TooltipTrigger.Hover" />, <see cref="TooltipTrigger.Focus" />, and <see cref="TooltipTrigger.Manual" />. Multiple options can be passed by separating them with a space. When manual is used, the tooltip must be activated programmatically.
    /// </summary>
    [Parameter]
    public List<TooltipTrigger> Triggers { get; set; } = [TooltipTrigger.Hover, TooltipTrigger.Focus];

    /// <summary>
    /// Removes the arrow from the tooltip.
    /// </summary>
    [Parameter]
    public bool NoArrow { get; set; } = false;

    /// <summary>
    /// Change the width the tooltip can grow to before wrapping occurs.
    /// </summary>
    [Parameter]
    public string MaxWidth { get; set; } = "";

    /// <summary>
    /// The distance in pixels from which to offset the tooltip away from its target.
    /// </summary>
    [Parameter]
    public int Distance { get; set; } = 8;

    /// <summary>
    /// Disables the tooltip so it won't show when triggered.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// The amount of time to wait before hiding the tooltip when the user mouses out.
    /// </summary>
    [Parameter]
    public int HideDelay { get; set; } = 0;

    /// <summary>
    /// The amount of time to wait before showing the tooltip when the user mouses in.
    /// </summary>
    [Parameter]
    public int ShowDelay { get; set; } = 150;

    /// <summary>
    /// The distance in pixels from which to offset the tooltip along its target.
    /// </summary>
    [Parameter]
    public int Skidding { get; set; } = 0;

    /// <summary>
    /// Emitted after the tooltip has hidden and all animations are complete.
    /// </summary>
    [Parameter]
    public EventCallback OnAfterHide { get; set; }

    /// <summary>
    /// Emitted when the tooltip begins to hide.
    /// </summary>
    [Parameter]
    public EventCallback OnHide { get; set; }

    /// <summary>
    /// Emitted after the tooltip has shown and all animations are complete.
    /// </summary>
    [Parameter]
    public EventCallback OnAfterShow { get; set; }

    /// <summary>
    /// Emitted when the tooltip begins to show.
    /// </summary>
    [Parameter]
    public EventCallback OnShow { get; set; }

    private string JoinTriggers { get => string.Join(" ", Triggers); }
    internal Dictionary<string, object> InternalAttributes = [];

    public ValueTask SetStateAsync(bool open) => SetComponentPropertyAsync("open", open);

    public ValueTask ToggleStateAsync() => ToggleComponentPropertyAsync("open");

    public ValueTask<bool> GetStateAsync() => GetComponentPropertyAsync<bool>("open");

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--max-width", MaxWidth)
            .Build();
    }

    public async Task TriggerAfterHideAsync()
    {
        await OnAfterHide.InvokeAsync();
    }

    public async Task TriggerHideAsync()
    {
        await OnHide.InvokeAsync();
    }

    public async Task TriggerAfterShowAsync()
    {
        await OnAfterShow.InvokeAsync();
    }

    public async Task TriggerShowAsync()
    {
        await OnShow.InvokeAsync();
    }
}
