@namespace RoarUI
@inherits RoarJsComponentBase

<RoarDependency ComponentName="tree" />

<CascadingValue Value="this" Name="Parent" IsFixed>
    <wa-tree selection="@(LeafOnly ? "leaf" : "single")" @onroarselectionchange="TriggerSelectionChangeAsync" @ref="Element" @attributes="AdditionalAttributes">
        @ChildContent
    </wa-tree>
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The selected value.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>
    /// Only allow leaf node to be selected.
    /// </summary>
    [Parameter]
    public bool LeafOnly { get; set; } = false;

    private Task TriggerSelectionChangeAsync(RoarSelectionChangeEventArgs args) => TriggerValueChange(new(args.Tree.SelectedValue));

    public async Task TriggerValueChange(TreeSelectionChangeEventArgs args)
    {
        Value = args.SelectedValue;
        await ValueChanged.InvokeAsync(Value);
    }
}
