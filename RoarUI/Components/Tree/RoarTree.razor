@namespace RoarUI
@inherits RoarJsEventComponentBase

<RoarDependency ComponentName="tree" />

<CascadingValue Value="this" Name="Parent" IsFixed>
    <wa-tree selection="@(LeafOnly ? "leaf" : "single")" @attributes="AdditionalAttributes" @ref="Element">
        @ChildContent
    </wa-tree>
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The selected value.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>
    /// Only allow leaf node to be selected.
    /// </summary>
    [Parameter]
    public bool LeafOnly { get; set; } = false;

    [JSInvokable]
    public async Task TriggerValueChange(TreeSelectionChangeEventArgs args)
    {
        Value = args.SelectedValue;
        await ValueChanged.InvokeAsync(Value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RegisterEventAsync("wa-selection-change", nameof(TreeSelectionChangeEventArgs), nameof(TriggerValueChange));
        }
    }
}
