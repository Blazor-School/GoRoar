@namespace RoarUI
@inherits RoarJsEventComponentBase

<RoarDependency ComponentName="tree" />

<CascadingValue Value="this" Name="Parent" IsFixed>
    <wa-tree selection="multiple" @attributes="AdditionalAttributes" @ref="Element">
        @ChildContent
    </wa-tree>
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The selected values.
    /// </summary>
    [Parameter]
    public List<string> Values { get; set; } = [];

    [Parameter]
    public EventCallback<List<string>> ValuesChanged { get; set; }

    [Parameter]
    public Expression<Func<List<string>>>? ValuesExpression { get; set; }

    [JSInvokable]
    public async Task TriggerValuesChange(TreeMultipleSelectionChangeEventArgs args)
    {
        Values = args.SelectedValues;
        await ValuesChanged.InvokeAsync(Values);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RegisterEventAsync("wa-selection-change", nameof(TreeMultipleSelectionChangeEventArgs), nameof(TriggerValuesChange));
        }
    }
}
