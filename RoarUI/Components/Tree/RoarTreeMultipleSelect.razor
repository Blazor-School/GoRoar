@namespace RoarUI
@inherits RoarJsComponentBase

<RoarDependency ComponentName="tree" />

<CascadingValue Value="this" Name="Parent" IsFixed>
    <wa-tree selection="multiple" @onroarselectionchange="TriggerSelectionChangeAsync" @ref="Element" @attributes="AdditionalAttributes">
        @ChildContent
    </wa-tree>
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The selected values.
    /// </summary>
    [Parameter]
    public List<string> Values { get; set; } = [];

    [Parameter]
    public EventCallback<List<string>> ValuesChanged { get; set; }

    [Parameter]
    public Expression<Func<List<string>>>? ValuesExpression { get; set; }

    private Task TriggerSelectionChangeAsync(RoarSelectionChangeEventArgs args) => TriggerValuesChange(new(args.Tree.SelectedValues));

    public async Task TriggerValuesChange(TreeMultipleSelectionChangeEventArgs args)
    {
        Values = args.SelectedValues;
        await ValuesChanged.InvokeAsync(Values);
    }
}
