@namespace RoarUI

<RoarDependency ComponentName="card" />

<wa-card appearance="@Appreance" orientation="@Orientation" @attributes="InternalAttributes">
    @ChildContent
</wa-card>

@code {
    /// <summary>
    /// The amount of space around and between sections of the card. Expects a single value. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? Spacing { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The card's visual appearance.
    /// </summary>
    [Parameter]
    public CardAppreance Appreance { get; set; }

    /// <summary>
    /// Renders the card's orientation
    /// </summary>
    [Parameter]
    public CardOrientation Orientation { get; set; }

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--spacing", Spacing)
            .Build();
    }
}
