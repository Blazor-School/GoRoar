@namespace RoarUI
@inherits RoarJsComponentBase

<RoarDependency ComponentName="comparison" />

<wa-comparison @onroarchange="TriggerChangeAsync" @ref="Element" @attributes="InternalAttributes">
    @ChildContent
</wa-comparison>

@code {
    /// <summary>
    /// The width of the dividing line. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? DividerWidth { get; set; }

    /// <summary>
    /// The size of the compare handle. Accepts CSS values, including var().
    /// </summary>
    [Parameter]
    public string? HandleSize { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public double Position { get; set; } = 50;

    [Parameter]
    public EventCallback<double> PositionChanged { get; set; }

    public async Task TriggerChangeAsync(RoarChangeEventArgs args)
    {
        Position = args.Comparison!.Position;
        await PositionChanged.InvokeAsync(args.Comparison.Position);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SetComponentPropertyAsync("position", Position);
        }
    }

    internal Dictionary<string, object> InternalAttributes = [];

    protected override void OnParametersSet()
    {
        InternalAttributes = new AttributeBuilder(AdditionalAttributes)
            .AddStyle("--divider-width", DividerWidth)
            .AddStyle("--handle-size", HandleSize)
            .Build();
    }
}
