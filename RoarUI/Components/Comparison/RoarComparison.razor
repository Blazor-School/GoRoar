@namespace RoarUI
@inherits RoarJsEventComponentBase

<RoarDependency ComponentName="comparison" />

<wa-comparison @attributes="AdditionalAttributes" @ref="Element">
    @ChildContent
</wa-comparison>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public double Position { get; set; } = 50;

    [Parameter]
    public EventCallback<double> PositionChanged { get; set; }

    [Parameter]
    public Expression<Func<double>>? PositionExpression { get; set; }

    [JSInvokable]
    public async Task NotifyChangeAsync(ComparisonChangeEventArgs args)
    {
        Position = args.Position;
        await PositionChanged.InvokeAsync(args.Position);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SetComponentPropertyAsync("position", Position);
            await RegisterEventAsync("change", nameof(ComparisonChangeEventArgs), nameof(NotifyChangeAsync));
        }
    }
}
