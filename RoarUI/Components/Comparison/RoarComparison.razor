@namespace RoarUI
@inherits RoarJsComponentBase

<RoarDependency ComponentName="comparison" />

<wa-comparison @onroarchange="TriggerChangeAsync" @ref="Element" @attributes="AdditionalAttributes">
    @ChildContent
</wa-comparison>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public double Position { get; set; } = 50;

    [Parameter]
    public EventCallback<double> PositionChanged { get; set; }

    [Parameter]
    public Expression<Func<double>>? PositionExpression { get; set; }

    public async Task TriggerChangeAsync(RoarChangeEventArgs args)
    {
        Position = args.Comparison.Position;
        await PositionChanged.InvokeAsync(args.Comparison.Position);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SetComponentPropertyAsync("position", Position);
        }
    }
}
