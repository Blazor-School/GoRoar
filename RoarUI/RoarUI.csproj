<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Title>RoarUI</Title>
		<Authors>Blazor School</Authors>
		<PackageId>RoarUI</PackageId>
		<VersionPrefix>10.0.0</VersionPrefix>
		<VersionSuffix></VersionSuffix>
		<Company>Blazor Innovations</Company>
		<Description>RoarUI is a Blazor component library for .NET 10 built on WebAwesome, with strongly typed C# APIs, flexible string values, custom theming, and Blazor form validation. Supports Interactive Server and standalone WebAssembly.</Description>
		<Copyright>Copyright (c) 2026 Blazor Innovations</Copyright>
		<PackageProjectUrl>https://github.com/Blazor-School/GoRoar</PackageProjectUrl>
		<PackageTags>blazor;razor;components;ui;webawesome;web-components;dotnet</PackageTags>
		<PackageReleaseNotes>Includes toast, time input, tag input, stepper, and resize observer components, plus updated nullable annotations, installation documentation, and licensing information.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
		<RepositoryUrl>https://github.com/Blazor-School/GoRoar</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Logo.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<Content Remove="bundleconfig.json" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\docs\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\docs\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\docs\NOTICE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\docs\Logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="bundleconfig.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\RoarUI.Generators\RoarUI.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
	</ItemGroup>

	<ItemGroup>
		<None Update="LICENSE.txt" Pack="True" PackagePath="\" />
		<None Update="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
